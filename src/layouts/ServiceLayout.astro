---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import { allServices } from '../data/services/index.js';
import '../styles/subpage-redesign.css';

interface ServiceItem {
  header?: string;
  content?: string;
}

interface Props {
  title: string;
  description: string;
  service: {
    title: string;
    description: string;
    benefits: {
      title: string;
      items: Array<string | ServiceItem>;
    };
    conclusion: string;
    slug?: string;
  };
}

const { title, description, service } = Astro.props;
const areas = service.benefits.items.map((item, index) => {
  if (typeof item === 'string') {
    return { title: item, points: [] as string[] };
  }

  return {
    title: item.header || `Área de trabajo ${index + 1}`,
    points: (item.content || '')
      .split('\n')
      .map((point) => point.replace(/^\s*[•-]\s*/, '').trim())
      .filter(Boolean),
  };
});
const relatedServices = allServices
  .filter((item) => item.slug !== service.slug && item.slug !== 'imagenes-para-amazon')
  .slice(0, 4);
---

<Layout
  title={title}
  description={description}
  type="website"
  pageType="service"
  contentSummary={description}
  structuredData={{ type: 'service', data: service }}
>
  <article class="sub-page svc-page">
    <section class="sub-hero svc-hero">
      <div class="sub-hero-grid" aria-hidden="true"></div>
      <div class="sub-shell sub-hero-shell svc-hero-shell">
        <div class="sub-hero-copy">
          <p class="sub-kicker"><i></i> Amazon Boost / Servicio especializado</p>
          <h1>{service.title}</h1>
          <p class="sub-lead">{service.description}</p>
          <div class="sub-actions">
            <a class="sub-button sub-button-primary" href="/#auditoria">
              Solicitar auditoría <Icon name="arrow-up-right" size={18} />
            </a>
            <a class="sub-button sub-button-secondary" href="#alcance">
              Ver alcance <Icon name="arrow-down" size={18} />
            </a>
          </div>
        </div>

        <aside class="svc-map" aria-label="Áreas principales del servicio">
          <div class="svc-map-top">
            <div>
              <span>Mapa de intervención</span>
              <strong>{service.slug?.replaceAll('-', ' ') || 'Amazon Boost'}</strong>
            </div>
            <small>Cuenta + negocio</small>
          </div>
          <div class="svc-map-list">
            {areas.slice(0, 5).map((area) => (
              <div>
                <i aria-hidden="true"></i>
                <strong>{area.title}</strong>
                <span>Incluido</span>
              </div>
            ))}
          </div>
          <div class="svc-map-foot">
            <span>Lectura conectada</span>
            <strong>Una prioridad clara para cada decisión.</strong>
          </div>
        </aside>
      </div>
      <div class="sub-hero-rail" aria-label="Método Amazon Boost">
        <span>Diagnóstico</span><i></i><span>Prioridad</span><i></i><span>Ejecución</span><i></i><span>Medición</span>
      </div>
    </section>

    <nav class="sub-jump" aria-label="Navegación de la página">
      <a href="#alcance">Qué incluye</a>
      <a href="#metodo">Cómo trabajamos</a>
      <a href="#servicios-relacionados">Servicios relacionados</a>
      <a class="is-cta" href="/#auditoria">Auditoría gratuita</a>
    </nav>

    <section id="alcance" class="sub-band sub-band-light">
      <div class="sub-shell">
        <div class="sub-heading sub-heading-split svc-heading">
          <div>
            <p class="sub-kicker sub-kicker-dark"><i></i> Alcance del servicio</p>
            <h2>{service.benefits.title}</h2>
          </div>
          <p>No acumulamos tareas. Ordenamos cada frente según su impacto en visibilidad, conversión, rentabilidad y capacidad de escalar.</p>
        </div>

        <div class="svc-scope">
          {areas.map((area) => (
            <article>
              <div class="svc-scope-title">
                <i aria-hidden="true"></i>
                <h3>{area.title}</h3>
              </div>
              {area.points.length > 0 && (
                <ul>
                  {area.points.map((point) => <li>{point}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="svc-statement">
      <div class="sub-shell">
        <p>Amazon Boost / Gestión con criterio</p>
        <h2>{service.conclusion}</h2>
      </div>
    </section>

    <section id="metodo" class="sub-band svc-method-band">
      <div class="sub-shell">
        <div class="sub-heading">
          <p class="sub-kicker sub-kicker-dark"><i></i> Nuestro método</p>
          <h2>Primero entendemos la cuenta. Después movemos lo que importa.</h2>
        </div>
        <div class="svc-method">
          <article>
            <span>Leer</span>
            <h3>Una visión completa</h3>
            <p>Reunimos datos de catálogo, tráfico, publicidad, inventario y margen para evitar decisiones aisladas.</p>
          </article>
          <article>
            <span>Decidir</span>
            <h3>Prioridades con impacto</h3>
            <p>Ordenamos las oportunidades por retorno, urgencia y capacidad real de ejecución dentro de la cuenta.</p>
          </article>
          <article>
            <span>Ejecutar</span>
            <h3>Un equipo sobre la cuenta</h3>
            <p>Implementamos, medimos y corregimos. Menos informes decorativos y más decisiones que mueven el negocio.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="servicios-relacionados" class="sub-band sub-related-band">
      <div class="sub-shell sub-related-layout">
        <div>
          <p class="sub-kicker"><i></i> Sistema Amazon Boost</p>
          <h2>Este servicio funciona mejor conectado al resto de la cuenta.</h2>
          <p>Explora las áreas que suelen intervenir en la misma oportunidad de crecimiento.</p>
        </div>
        <div class="sub-related-grid">
          {relatedServices.map((item) => (
            <a href={`/servicios/${item.slug}/`}>
              <span>Servicio relacionado</span>
              <strong>{item.title}</strong>
              <p>{item.metaDescription}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sub-final">
      <div class="sub-shell">
        <div>
          <p>Tu siguiente decisión empieza con una lectura clara</p>
          <h2>Veamos qué está frenando tu cuenta de Amazon.</h2>
        </div>
        <a href="/#auditoria">Solicitar auditoría <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </section>
  </article>
</Layout>
