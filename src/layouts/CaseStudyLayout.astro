---
import Layout from './Layout.astro';
import '../styles/subpage-redesign.css';

interface Props {
  title: string;
  description: string;
  caseStudy: any;
}

const { title, description, caseStudy } = Astro.props;
const paragraphs = (value: string) => value.split('\n\n').filter(Boolean);
---

<Layout title={title} description={description} pageType="case-study" contentSummary={description}>
  <article class="sub-page case-detail">
    <section class="case-detail-hero">
      <div class="sub-hero-grid" aria-hidden="true"></div>
      <div class="sub-shell case-detail-hero-layout">
        <div>
          <a class="case-back" href="/casos-de-exito/">← Todos los casos</a>
          <p class="sub-kicker"><i></i> {caseStudy.industry} / Caso de éxito</p>
          <h1>{caseStudy.title}</h1>
          <p>{description}</p>
        </div>
        <figure>
          <img src={caseStudy.image} alt={caseStudy.title} />
          <figcaption><span>Cliente</span><strong>{caseStudy.client || 'Marca en Amazon'}</strong></figcaption>
        </figure>
      </div>
    </section>

    <section class="case-metrics" aria-label="Resultados principales">
      <div class="sub-shell">
        <div><strong>{caseStudy.results.revenue}</strong><span>Incremento de ingresos</span></div>
        <div><strong>{caseStudy.results.ranking}</strong><span>Posicionamiento</span></div>
        <div><strong>{caseStudy.results.conversion}</strong><span>Conversión / publicidad</span></div>
        <p>Datos del caso actual. La colección se actualizará con la nueva selección verificada de Amazon Boost.</p>
      </div>
    </section>

    <section class="case-story">
      <div class="sub-shell case-story-layout">
        <aside>
          <span>La lectura</span>
          <strong>Reto, estrategia y resultado.</strong>
          <nav><a href="#reto">El reto</a><a href="#estrategia">La estrategia</a><a href="#resultado">El resultado</a></nav>
        </aside>
        <div class="case-story-content">
          <section id="reto">
            <p class="case-section-label">El punto de partida</p>
            <h2>El reto</h2>
            {paragraphs(caseStudy.challenge).map((paragraph) => <p>{paragraph}</p>)}
          </section>

          <section id="estrategia">
            <p class="case-section-label">La intervención</p>
            <h2>La estrategia</h2>
            <p>{caseStudy.solution}</p>
            <ul>{caseStudy.approach.map((step: string) => <li>{step}</li>)}</ul>
          </section>

          <section id="resultado">
            <p class="case-section-label">La consecuencia</p>
            <h2>El resultado</h2>
            <p>{caseStudy.conclusion}</p>
            {caseStudy.results.additional && (
              <div class="case-additional">
                {caseStudy.results.additional.map((item: any) => <div><span>{item.label}</span><strong>{item.value}</strong></div>)}
              </div>
            )}
            {caseStudy.results.proofImage && (
              <figure class="case-proof">
                <button type="button" data-case-proof={caseStudy.results.proofImage.url} aria-label="Ampliar prueba del resultado">
                  <img src={caseStudy.results.proofImage.url} alt={caseStudy.results.proofImage.alt} loading="lazy" />
                </button>
                <figcaption>{caseStudy.results.proofImage.caption} <small>{caseStudy.results.proofImage.source}</small></figcaption>
              </figure>
            )}
          </section>

          {caseStudy.fullContent && (
            <section class="case-deep-dive">
              <p class="case-section-label">Análisis completo</p>
              <h2>Detrás del resultado</h2>
              <p>{caseStudy.fullContent.introduction}</p>
              {caseStudy.fullContent.sections.map((section: any) => (
                <div>
                  <h3>{section.title}</h3>
                  <p>{section.content}</p>
                  {section.bulletPoints && <ul>{section.bulletPoints.map((point: string) => <li>{point}</li>)}</ul>}
                  {section.imageNote && <small>{section.imageNote}</small>}
                </div>
              ))}
            </section>
          )}
        </div>
      </div>
    </section>

    {caseStudy.testimonial && (
      <section class="case-testimonial">
        <div class="sub-shell">
          <p>“{caseStudy.testimonial.quote}”</p>
          <div><strong>{caseStudy.testimonial.author}</strong><span>{caseStudy.testimonial.position}</span></div>
        </div>
      </section>
    )}

    <section class="sub-final">
      <div class="sub-shell">
        <div><p>Resultados distintos empiezan con decisiones distintas</p><h2>Veamos qué oportunidad esconde tu cuenta.</h2></div>
        <a href="/#auditoria">Solicitar auditoría <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </article>

  <dialog class="case-proof-dialog" aria-label="Prueba ampliada"><button type="button" aria-label="Cerrar">×</button><img alt="Prueba ampliada" /></dialog>
</Layout>

<script>
  const proofButton = document.querySelector<HTMLButtonElement>('[data-case-proof]');
  const proofDialog = document.querySelector<HTMLDialogElement>('.case-proof-dialog');
  const proofImage = proofDialog?.querySelector<HTMLImageElement>('img');
  proofButton?.addEventListener('click', () => {
    if (!proofDialog || !proofImage || !proofButton.dataset.caseProof) return;
    proofImage.src = proofButton.dataset.caseProof;
    proofImage.alt = proofButton.querySelector('img')?.alt || 'Prueba ampliada';
    proofDialog.showModal();
  });
  proofDialog?.querySelector('button')?.addEventListener('click', () => proofDialog.close());
</script>

<style>
  .case-detail-hero{position:relative;overflow:hidden;background:#090909;color:#fff}.case-detail-hero-layout{position:relative;z-index:1;min-height:710px;display:grid;grid-template-columns:1.05fr .72fr;gap:85px;align-items:center;padding:74px 0}.case-back{display:inline-block;margin-bottom:50px;color:#aaa;font-size:.7rem;font-weight:800}.case-detail-hero h1{max-width:880px;margin:0;font-size:clamp(3.5rem,6.2vw,7rem);line-height:.89;font-weight:850}.case-detail-hero-layout>div>p:last-child{max-width:720px;margin:25px 0 0;color:#aaa;line-height:1.65}.case-detail-hero figure{position:relative;margin:0;aspect-ratio:4/5;background:#151515}.case-detail-hero figure img{width:100%;height:100%;object-fit:cover}.case-detail-hero figcaption{position:absolute;right:0;bottom:0;min-width:210px;padding:17px;background:#ff9900;color:#111}.case-detail-hero figcaption span,.case-detail-hero figcaption strong{display:block}.case-detail-hero figcaption span{font-size:.55rem;font-weight:850;text-transform:uppercase}.case-detail-hero figcaption strong{margin-top:6px;font-size:.75rem}.case-metrics{background:#ff9900;color:#111}.case-metrics .sub-shell{display:grid;grid-template-columns:repeat(3,.7fr) 1.2fr}.case-metrics .sub-shell>div,.case-metrics .sub-shell>p{min-height:160px;margin:0;padding:28px;border-left:1px solid rgba(0,0,0,.22)}.case-metrics .sub-shell>*:last-child{border-right:1px solid rgba(0,0,0,.22)}.case-metrics strong,.case-metrics span{display:block}.case-metrics strong{font-size:2.25rem}.case-metrics span{margin-top:45px;font-size:.57rem;font-weight:850;text-transform:uppercase}.case-metrics p{display:flex;align-items:flex-end;font-size:.72rem;line-height:1.6}.case-story{padding:115px 0;background:#f4f4ef;color:#111}.case-story-layout{display:grid;grid-template-columns:270px minmax(0,820px);gap:110px;justify-content:center}.case-story aside{position:sticky;top:145px;align-self:start;padding-top:7px}.case-story aside>span,.case-story aside>strong{display:block}.case-story aside>span{color:#a46100;font-size:.58rem;font-weight:850;text-transform:uppercase}.case-story aside>strong{margin-top:12px;font-size:1.25rem}.case-story aside nav{display:grid;margin-top:40px;border-top:1px solid #d0d0ca}.case-story aside a{padding:13px 0;border-bottom:1px solid #d0d0ca;color:#555750;font-size:.72rem}.case-story-content>section{padding:0 0 80px;margin-bottom:80px;border-bottom:1px solid #cecec8}.case-section-label{margin:0 0 18px!important;color:#a46100!important;font-size:.6rem!important;font-weight:850;text-transform:uppercase}.case-story-content h2{margin:0 0 30px;font-size:clamp(3rem,5vw,5.2rem);line-height:.94}.case-story-content h3{margin:38px 0 12px;font-size:1.55rem}.case-story-content p{color:#4f514b;font-size:1rem;line-height:1.78}.case-story-content ul{display:grid;gap:12px;margin:28px 0 0;padding:0;list-style:none}.case-story-content li{position:relative;padding:15px 0 15px 24px;border-top:1px solid #d0d0ca;color:#353732;line-height:1.55}.case-story-content li:before{content:"";position:absolute;left:2px;top:23px;width:7px;height:7px;background:#ff9900}.case-additional{margin-top:35px;border-top:1px solid #d0d0ca}.case-additional div{display:flex;justify-content:space-between;gap:30px;padding:16px 3px;border-bottom:1px solid #d0d0ca}.case-proof{margin:42px 0 0}.case-proof button{width:100%;padding:0;border:0;background:#111;cursor:zoom-in}.case-proof img{display:block;width:100%;height:auto}.case-proof figcaption{margin-top:12px;color:#555750;font-size:.68rem}.case-proof figcaption small{display:block;margin-top:5px}.case-deep-dive>div{padding:30px 0;border-top:1px solid #d0d0ca}.case-deep-dive small{display:block;margin-top:15px;color:#777970;line-height:1.5}.case-testimonial{padding:105px 0;background:#101010;color:#fff}.case-testimonial .sub-shell{display:grid;grid-template-columns:1fr auto;gap:70px;align-items:end}.case-testimonial p{max-width:1050px;margin:0;font-size:clamp(2.5rem,4.6vw,5rem);line-height:1}.case-testimonial strong,.case-testimonial span{display:block}.case-testimonial span{margin-top:6px;color:#92948e;font-size:.67rem}.case-proof-dialog{width:min(1100px,calc(100% - 32px));height:min(90vh,900px);padding:0;border:1px solid #333;background:#0a0a0a}.case-proof-dialog::backdrop{background:rgba(0,0,0,.88)}.case-proof-dialog img{width:100%;height:100%;object-fit:contain}.case-proof-dialog button{position:absolute;top:12px;right:12px;width:42px;height:42px;border:1px solid #555;background:#111;color:#fff;font-size:1.7rem}
  @media(max-width:900px){.case-detail-hero-layout{grid-template-columns:1fr}.case-detail-hero figure{max-width:650px;aspect-ratio:4/3}.case-metrics .sub-shell{grid-template-columns:1fr 1fr}.case-metrics .sub-shell>*:nth-child(3){border-top:1px solid rgba(0,0,0,.22)}.case-story-layout{grid-template-columns:1fr;gap:60px}.case-story aside{position:static}.case-story aside nav{grid-template-columns:repeat(3,1fr)}.case-story aside a{border-right:1px solid #d0d0ca}.case-testimonial .sub-shell{grid-template-columns:1fr}}
  @media(max-width:700px){.case-detail-hero-layout{min-height:auto;padding:72px 0 55px;gap:42px}.case-back{margin-bottom:35px}.case-detail-hero h1{font-size:clamp(2.9rem,12vw,4rem)}.case-metrics .sub-shell{grid-template-columns:1fr}.case-metrics .sub-shell>div,.case-metrics .sub-shell>p{min-height:115px;border-right:1px solid rgba(0,0,0,.22);border-bottom:1px solid rgba(0,0,0,.22)}.case-metrics span{margin-top:20px}.case-story{padding:75px 0}.case-story aside nav{grid-template-columns:1fr}.case-story-content>section{padding-bottom:55px;margin-bottom:55px}.case-story-content h2{font-size:clamp(2.7rem,12vw,3.8rem)}.case-testimonial{padding:75px 0}}
</style>
