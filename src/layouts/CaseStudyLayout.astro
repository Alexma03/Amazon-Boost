---
import Layout from './Layout.astro';
import SubpageBreadcrumbs from '../components/SubpageBreadcrumbs.astro';
import CaseSalesChart from '../components/CaseSalesChart.astro';
import GuideLinks from '../components/GuideLinks.astro';
import ServiceContact from '../components/ServiceContact.astro';
import { caseLabel, casePath, caseStudiesBySlug, type CaseStudy } from '../data/case-studies/catalogue';
import { serviceDirectory } from '../data/service-pages';
import '../styles/growth-pages.css';
import '../styles/case-studies.css';

interface Props { caseStudy: CaseStudy }
const { caseStudy: study } = Astro.props;
const service = serviceDirectory.find((entry) => entry.path === study.service)!;
const related = study.related.map((slug) => caseStudiesBySlug[slug]);
const indexable = study.kind === 'documented';
---
<Layout title={study.metaTitle} description={study.metaDescription} image={study.image?.src ?? null} canonicalPath={casePath(study)} type={indexable ? 'article' : 'website'} pageType="case-study" aiOptimized={false} noindex={!indexable} structuredData={indexable ? { type: 'article', data: { title: study.title, description: study.metaDescription, image: study.image?.src, dateModified: '2026-08-28' } } : undefined}>
  <article class="growth-page case-page" data-case-status={study.kind}>
    <header class="growth-hero case-detail-hero"><div class="growth-shell">
      <SubpageBreadcrumbs items={[{ name: 'Inicio', path: '/' }, { name: 'Casos de éxito', path: '/casos-de-exito/' }, { name: study.sector, path: casePath(study) }]} />
      <p class="growth-eyebrow">{caseLabel(study)} / {study.sector}</p>
      {study.headline ? <h1 class="case-sales-title"><span>{study.headline.lead}</span>{' '}<strong>{study.headline.value}</strong>{' '}<span>{study.headline.tail}</span></h1> : <h1>{study.title}</h1>}
      <p class="case-hero-lead">{study.summary}</p>
      {!indexable && <p class="case-status">{study.kind === 'draft' ? 'Historia en preparación. El punto de partida es un testimonio facilitado; falta incorporar documentación antes de publicar un caso completo.' : 'Esta página pertenece a la colección anterior. Sus resultados están en revisión y no se presentan como evidencia actual.'}</p>}
      <dl class="case-context">{study.context.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
    </div></header>
    {study.metrics.length > 0 && <section class="case-detail-metrics" aria-label="Resultados y contexto"><div class="growth-shell"><dl>{study.metrics.map((metric) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl></div></section>}
    <div class="growth-shell case-reading">
      <aside class="case-toc"><p class="growth-eyebrow">Detrás del resultado</p><nav aria-label="Índice del caso">{study.sections.map((section) => <a href={'#' + section.id}>{section.label}</a>)}<a href="#fuentes">Datos y contexto</a>{study.testimonial && <a href="#experiencia">La voz del cliente</a>}{study.pending && <a href="#documentacion">Por documentar</a>}</nav><a class="case-toc-service" href={service.path}><span>Trabajarlo en tu cuenta</span><strong>{service.title}</strong></a></aside>
      <div class="case-story-body">
        {study.image && <figure class="case-detail-product"><div class="case-product"><img src={study.image.src} alt={study.image.alt} width="1536" height="1024" loading="lazy" decoding="async" /></div><figcaption>{study.image.caption}</figcaption></figure>}
        {study.sections.map((section) => <section class="case-story-section" id={section.id}>
          <p class="growth-eyebrow">{section.label}</p><h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.decisions && <div class="case-decisions">{section.decisions.map((decision) => <div><h3>{decision.title}</h3><p>{decision.text}</p></div>)}</div>}
        </section>)}
        <section class="case-story-section" id="fuentes"><p class="growth-eyebrow">Datos y contexto</p><h2>{study.chart ? 'Las cifras, con su contexto.' : 'Qué sabemos de esta historia.'}</h2>
          {study.chart && <CaseSalesChart kind={study.chart} />}
          <p class="case-disclosure">{study.evidence}</p>
          {study.proofImage && <figure class="case-evidence-image"><a href={study.proofImage.src} target="_blank" rel="noopener noreferrer" aria-label="Abrir captura original de Seller Central"><img src={study.proofImage.src} alt={study.proofImage.alt} width="868" height="482" loading="lazy" decoding="async" /></a><figcaption>{study.proofImage.caption} <a class="growth-text-link" href={study.proofImage.src} target="_blank" rel="noopener noreferrer">Ver captura original</a></figcaption></figure>}
          {indexable && <p>Estos resultados describen un proyecto concreto. No son una previsión ni una garantía para otras cuentas.</p>}
        </section>
        {study.pending && <section class="case-story-section" id="documentacion"><p class="growth-eyebrow">Para completar la historia</p><h2>La documentación que falta.</h2><ul class="case-pending-list">{study.pending.map((item) => <li>{item}</li>)}</ul></section>}
      </div>
    </div>
    {study.testimonial && <section class="case-client-voice" id="experiencia"><div class="growth-shell">
      <p class="growth-eyebrow">La voz detrás del resultado</p>
      <blockquote><span aria-hidden="true">“</span><p>{study.testimonial.quote}</p></blockquote>
      <div class="case-client-byline"><p><strong>{study.testimonial.author}</strong><span>{study.testimonial.role}</span><span>{study.testimonial.source}</span></p>{study.testimonial.url && <a href={study.testimonial.url} target="_blank" rel="noopener noreferrer">{study.testimonial.source === 'Trustpilot' && <img src="/icons/brands/trustpilot-logo.svg" width="105" height="26" alt="Trustpilot" />}<span>Leer en la plataforma</span></a>}</div>
    </div></section>}
    <GuideLinks slugs={study.guides} title="Entiende las decisiones detrás del caso." />
    <section class="case-next"><div class="growth-shell"><p class="growth-eyebrow">Otra forma de crecer en Amazon</p><nav class="case-next-list" aria-label="Otros casos de éxito">{related.map((entry) => <a href={casePath(entry)}>{entry.title}<img src="/icons/lucide/arrow-right.svg" width="24" height="24" alt="" /></a>)}</nav><a class="growth-text-link" href="/casos-de-exito/">Todos los casos de éxito</a></div></section>
    <ServiceContact topic={service.title} service={service.path} preparation={['Tu catálogo y marketplace.', 'El reto que quieres resolver.', 'El periodo que quieres analizar.']} />
  </article>
</Layout>
