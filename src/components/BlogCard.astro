---
import { readingMinutes, type BlogPost } from '../data/blog';
interface Props { post: Omit<BlogPost, 'date'>; filterable?: boolean; href?: string; draft?: boolean }
const { post, filterable = false, href = `/blog/${post.slug}/`, draft = false } = Astro.props;
---
<article class:list={['blog-card', { 'blog-card-draft': draft, 'blog-card-editorial': Boolean(post.imageCaption) }]} data-blog-card={filterable ? '' : undefined} data-search-text={filterable ? [post.title, post.excerpt, ...post.tags].join(' ') : undefined} data-category={filterable ? post.category : undefined}>
  <a class="blog-card-link" href={href}>
    <img class="blog-card-cover" src={post.image} alt="" width="1080" height="675" loading="lazy" decoding="async" />
    <div class="blog-card-copy">
      <div class="blog-card-meta"><span>{post.category}</span><span>{readingMinutes(post)} min</span></div>
      <h3>{post.title}</h3>
      <p>{post.excerpt}</p>
      <span class="growth-link-label">{draft ? 'Revisar artículo' : 'Leer análisis'} <img src="/icons/lucide/arrow-right.svg" width="20" height="20" alt="" /></span>
    </div>
  </a>
</article>

<style>
  .blog-card-draft .blog-card-cover { object-fit: contain; }
  .blog-card-editorial .blog-card-cover { object-fit: contain; aspect-ratio: 1200 / 630; background: #080808; }
</style>
