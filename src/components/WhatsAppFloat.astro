---
const whatsappUrl = "https://wa.me/34650606400?text=Hola%20Sergio%2C%20quiero%20hablar%20sobre%20mi%20cuenta%20de%20Amazon.";
---

<a class="ab-whatsapp-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="Contactar con Amazon Boost por WhatsApp">
  <span class="ab-whatsapp-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false"><path d="M12.04 2a9.9 9.9 0 0 0-8.45 15.06L2.05 22l5.03-1.57A9.9 9.9 0 1 0 12.04 2Zm5.77 14.24c-.24.68-1.4 1.3-1.94 1.38-.49.08-1.11.11-1.79-.11-.41-.13-.95-.31-1.63-.61-2.87-1.24-4.74-4.13-4.88-4.32-.14-.19-1.16-1.55-1.16-2.95s.73-2.09.99-2.38c.26-.29.57-.36.76-.36h.55c.18.01.41-.07.64.49.24.58.81 1.98.88 2.12.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.3-.12.59.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.64-.14.26.1 1.67.79 1.96.94.29.14.48.22.55.34.07.12.07.7-.17 1.38Z" /></svg>
  </span>
  <span class="ab-whatsapp-copy"><small><i aria-hidden="true"></i>Hablemos de tu marca</small><strong>Habla con Amazon Boost</strong></span>
  <svg class="ab-whatsapp-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M8 7h9v9" /></svg>
</a>

<style>
  .ab-whatsapp-float{--wa:#25d366;position:fixed;z-index:45;right:20px;bottom:20px;min-height:64px;display:flex;align-items:center;gap:13px;padding:9px 18px 9px 10px;overflow:hidden;border:1px solid rgba(37,211,102,.45);border-radius:999px;background:#0d0f0e;color:#fff;box-shadow:0 18px 44px rgba(0,0,0,.38),0 0 30px rgba(37,211,102,.22);transition:transform .2s ease,background .2s ease,color .2s ease,box-shadow .2s ease,border-color .2s ease;animation:ab-wa-enter .6s cubic-bezier(.2,.8,.2,1) .8s both}
  /* Light sweep across the button every few seconds. */
  .ab-whatsapp-float::after{content:"";position:absolute;top:0;bottom:0;left:0;width:45%;pointer-events:none;background:linear-gradient(100deg,transparent,rgba(255,255,255,.2),transparent);transform:translateX(-140%);animation:ab-wa-shine 7s ease-in-out 3s infinite}
  .ab-whatsapp-float:hover,.ab-whatsapp-float:focus-visible{background:var(--wa);border-color:var(--wa);color:#06130b;transform:translateY(-4px);box-shadow:0 22px 50px rgba(0,0,0,.4),0 0 44px rgba(37,211,102,.5)}
  .ab-whatsapp-float:focus-visible{outline:2px solid #fff;outline-offset:3px}
  .ab-whatsapp-mark{position:relative;flex:none;width:46px;height:46px;display:grid;place-items:center;border-radius:50%;background:var(--wa);color:#fff;transition:background .2s ease,color .2s ease}
  .ab-whatsapp-mark::before,.ab-whatsapp-mark::after{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid var(--wa);opacity:0;animation:ab-wa-pulse 2.6s ease-out infinite}
  .ab-whatsapp-mark::after{animation-delay:1.3s}
  .ab-whatsapp-float:hover .ab-whatsapp-mark,.ab-whatsapp-float:focus-visible .ab-whatsapp-mark{background:#06130b;color:var(--wa)}
  .ab-whatsapp-mark svg{position:relative;width:25px;height:25px;display:block;fill:currentColor}
  .ab-whatsapp-copy{position:relative;display:grid;gap:2px;letter-spacing:0}
  .ab-whatsapp-copy small{display:flex;align-items:center;gap:6px;font-size:.66rem;font-weight:650;opacity:.78}
  .ab-whatsapp-copy small i{width:7px;height:7px;border-radius:50%;background:var(--wa);box-shadow:0 0 8px var(--wa)}
  .ab-whatsapp-float:hover .ab-whatsapp-copy small i,.ab-whatsapp-float:focus-visible .ab-whatsapp-copy small i{background:#06130b;box-shadow:none}
  .ab-whatsapp-copy strong{font-size:.88rem;letter-spacing:0}
  .ab-whatsapp-arrow{position:relative;width:18px;height:18px;margin-left:2px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s ease}
  .ab-whatsapp-float:hover .ab-whatsapp-arrow{transform:translate(2px,-2px)}
  @keyframes ab-wa-enter{from{opacity:0;transform:translateY(24px)}}
  @keyframes ab-wa-pulse{0%{opacity:.7;transform:scale(1)}80%,100%{opacity:0;transform:scale(1.7)}}
  @keyframes ab-wa-shine{0%,70%{transform:translateX(-140%)}100%{transform:translateX(340%)}}
  @media(max-width:640px){.ab-whatsapp-float{right:12px;bottom:12px;width:56px;height:56px;min-height:0;padding:0;overflow:visible;border:0;border-radius:50%;background:transparent;box-shadow:0 12px 30px rgba(0,0,0,.3)}.ab-whatsapp-float::after{content:none}.ab-whatsapp-float:hover{background:transparent}.ab-whatsapp-mark{width:56px;height:56px}.ab-whatsapp-mark svg{width:29px;height:29px}.ab-whatsapp-copy,.ab-whatsapp-arrow{display:none}}
  @media(prefers-reduced-motion:reduce){.ab-whatsapp-float,.ab-whatsapp-float::after,.ab-whatsapp-mark::before,.ab-whatsapp-mark::after{animation:none;transition:none}}
</style>
