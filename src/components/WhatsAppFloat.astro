---
const whatsappUrl = "https://wa.me/34650606400?text=Hola%20Sergio%2C%20quiero%20hablar%20sobre%20mi%20cuenta%20de%20Amazon.";
---

<a class="ab-whatsapp-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="Contactar con Amazon Boost por WhatsApp">
  <span class="ab-whatsapp-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false"><path d="M12.04 2a9.9 9.9 0 0 0-8.45 15.06L2.05 22l5.03-1.57A9.9 9.9 0 1 0 12.04 2Zm5.77 14.24c-.24.68-1.4 1.3-1.94 1.38-.49.08-1.11.11-1.79-.11-.41-.13-.95-.31-1.63-.61-2.87-1.24-4.74-4.13-4.88-4.32-.14-.19-1.16-1.55-1.16-2.95s.73-2.09.99-2.38c.26-.29.57-.36.76-.36h.55c.18.01.41-.07.64.49.24.58.81 1.98.88 2.12.07.14.12.31.02.5-.1.19-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.3-.12.59.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.64-.14.26.1 1.67.79 1.96.94.29.14.48.22.55.34.07.12.07.7-.17 1.38Z" /></svg>
  </span>
  <span class="ab-whatsapp-copy"><small>¿Tienes alguna pregunta?</small><strong>Pregúntanos por WhatsApp</strong></span>
</a>

<style>
  .ab-whatsapp-float{position:fixed;z-index:45;right:20px;bottom:20px;min-height:60px;display:flex;align-items:center;gap:12px;padding:8px 17px 8px 9px;border:1px solid rgba(255,255,255,.6);border-radius:20px;background:rgba(255,255,255,.72);color:#111;box-shadow:0 16px 42px rgba(0,0,0,.18);backdrop-filter:blur(24px) saturate(1.15);transition:transform .18s ease,background .18s ease,color .18s ease,box-shadow .18s ease}
  .ab-whatsapp-float:hover{background:#111;color:#fff;transform:translateY(-3px);box-shadow:0 20px 48px rgba(0,0,0,.26)}
  .ab-whatsapp-mark{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:#20b85a;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.28)}
  .ab-whatsapp-mark svg{width:23px;height:23px;display:block;fill:currentColor}
  .ab-whatsapp-copy{display:grid;gap:1px;letter-spacing:0}
  .ab-whatsapp-copy small{font-size:.6rem;font-weight:650;opacity:.58}
  .ab-whatsapp-copy strong{font-size:.8rem;letter-spacing:0}
  @media(max-width:640px){.ab-whatsapp-float{right:12px;bottom:12px;width:52px;height:52px;min-height:0;padding:0;border:0;border-radius:50%;background:transparent;box-shadow:0 12px 30px rgba(0,0,0,.22);backdrop-filter:none}.ab-whatsapp-float:hover{background:transparent}.ab-whatsapp-mark{width:52px;height:52px}.ab-whatsapp-mark svg{width:27px;height:27px}.ab-whatsapp-copy{display:none}}
  @media(prefers-reduced-motion:reduce){.ab-whatsapp-float{transition:none}}
</style>
