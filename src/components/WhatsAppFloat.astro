---
const whatsappUrl = "https://wa.me/34650606400?text=Hola%20Sergio%2C%20quiero%20hablar%20sobre%20mi%20cuenta%20de%20Amazon.";
---

<a class="ab-whatsapp-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="Contactar con Amazon Boost por WhatsApp">
  <span class="ab-whatsapp-mark" aria-hidden="true">W</span>
  <span class="ab-whatsapp-copy"><small>¿Hablamos de tu cuenta?</small><strong>WhatsApp</strong></span>
</a>

<style>
  .ab-whatsapp-float{position:fixed;z-index:45;right:20px;bottom:20px;min-height:58px;display:flex;align-items:center;gap:11px;padding:8px 14px 8px 9px;border:1px solid rgba(255,255,255,.5);border-radius:8px;background:#168c4d;color:#fff;box-shadow:0 14px 38px rgba(0,0,0,.24);transition:transform .18s ease,background .18s ease,box-shadow .18s ease}
  .ab-whatsapp-float:hover{background:#117940;transform:translateY(-3px);box-shadow:0 18px 42px rgba(0,0,0,.3)}
  .ab-whatsapp-mark{width:40px;height:40px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.7);border-radius:50%;font-size:1rem;font-weight:900}
  .ab-whatsapp-copy{display:grid;gap:1px;letter-spacing:0}
  .ab-whatsapp-copy small{font-size:.62rem;font-weight:600;opacity:.82}
  .ab-whatsapp-copy strong{font-size:.84rem;letter-spacing:0}
  @media(max-width:640px){.ab-whatsapp-float{right:12px;bottom:12px;min-height:50px;padding:6px 10px 6px 6px}.ab-whatsapp-mark{width:36px;height:36px}.ab-whatsapp-copy small{display:none}.ab-whatsapp-copy strong{font-size:.76rem}}
  @media(prefers-reduced-motion:reduce){.ab-whatsapp-float{transition:none}}
</style>
