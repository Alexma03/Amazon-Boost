---
import { featuredCaseStudies } from '../data/case-studies/catalogue';
import CaseSummary from './CaseSummary.astro';
import '../styles/growth-pages.css';
import '../styles/case-studies.css';
---
<section id="case-studies" class="growth-page case-page case-featured-list">
  <div class="growth-shell">
    <div class="growth-section-head"><p class="growth-eyebrow">Casos de éxito</p><h2>La estrategia se demuestra en la cuenta.</h2></div>
    {featuredCaseStudies.map((study) => <CaseSummary study={study} />)}
    <a class="growth-text-link" href="/casos-de-exito/">Todos los casos de éxito</a>
  </div>
</section>
