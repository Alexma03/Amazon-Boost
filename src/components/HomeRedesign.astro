  </header>
  <div class="ab-founder-portrait" data-reveal>
    <img src="/images/sergio-porras-amazon-boost-v2-1440.webp" srcset="/images/sergio-porras-amazon-boost-v2-800.webp 800w, /images/sergio-porras-amazon-boost-v2-1440.webp 1440w" sizes="(max-width: 1100px) 100vw, 41vw" width="1440" height="1440" alt="Sergio Porras, fundador de Amazon Boost" loading="lazy" decoding="async" />
    <div class="ab-portrait-label">
      <div class="ab-portrait-identity"><strong>Sergio Porras</strong><span>Fundador / Amazon Boost</span></div>
      <a class="ab-founder-linkedin" href="https://www.linkedin.com/in/sergio-deroman-amazon/" target="_blank" rel="noopener noreferrer" aria-label="Ver el perfil de Sergio Porras en LinkedIn (se abre en una pestaña nueva)" title="Ver perfil en LinkedIn"><span aria-hidden="true">in</span></a>
    </div>
  </div>
