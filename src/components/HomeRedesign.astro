---
import "../styles/home-redesign.css";
import "../styles/macbook-scroll.css";
import { homeShowcase, websiteReviews } from "../data/home-showcase";
import FeaturedCases from "./FeaturedCases.astro";
import ReviewCard from "./ReviewCard.astro";
import DiagnosticExperience from "./DiagnosticExperience.astro";
import Icon from "./Icon.astro";

const tickerItems = [
  "Seller Central", "Amazon Ads", "SEO Amazon", "FBA", "FBM", "Buy Box",
  "Conversión", "Catálogo", "Stock", "Escalado", "Paneuropeo", "Amazon Europa",
  "Amazon.es", "Amazon.fr", "Amazon.it", "Amazon.de", "Logística europea",
  "Contenido A+", "Brand Store", "PPC", "TACOS", "Ranking orgánico",
  "Inventario", "Margen", "Gestión integral", "Expansión internacional",
];

const services = [
  { step: "Detectar", name: "Auditoría de cuenta", copy: "Leemos Seller Central para detectar qué frena ventas, margen y posicionamiento.", tags: ["Cuenta", "Catálogo", "Oportunidades"], href: "/servicios/auditoria-de-cuenta/" },
  { step: "Resolver", name: "Desbloqueos e incidencias", copy: "Ordenamos la documentación y la respuesta para cuentas bloqueadas, fondos retenidos e incidencias críticas.", tags: ["Suspensiones", "Fondos retenidos", "Apelaciones"], href: "/servicios/desbloqueos-amazon/" },
  { step: "Rentabilizar", name: "PPC y Amazon Ads", copy: "Estrategia publicitaria conectada con posicionamiento, ventas y margen.", tags: ["ACOS", "TACOS", "ROAS"], href: "/servicios/gestion-de-ppc/" },
  { step: "Convertir", name: "Listings que convierten", copy: "SEO, copy, imágenes y A+ para ganar clics, convertir y mejorar el ranking orgánico.", tags: ["SEO Amazon", "CTR", "Conversión"], href: "/servicios/optimizacion-de-listados/" },
  { step: "Vender", name: "Imágenes que ayudan a vender", copy: "Imagen principal, infografías y A+ para explicar el producto y facilitar la decisión de compra.", tags: ["Creatividad", "Infografías", "A+"], href: "/servicios/imagenes-para-amazon/" },
  { step: "Escalar", name: "Gestión integral", copy: "Decisiones semanales sobre Amazon Ads, stock, precio, catálogo y Amazon Europa.", tags: ["Seller Central", "FBA / FBM", "Europa"], href: "/servicios/gestion-de-cuenta/" },
];

const process = [
  { title: "Leemos", text: "Unimos ventas, publicidad y margen en informes claros." },
  { title: "Priorizamos", text: "Ordenamos oportunidades por impacto y definimos el siguiente paso." },
  { title: "Ejecutamos", text: "Conectamos publicidad, catálogo y operativa; aplicamos y medimos." },
  { title: "Escalamos", text: "Reforzamos lo que funciona con inversión, stock y margen." },
];

const reviewRail = [
  ...homeShowcase.featuredCase.reviews.map((review, index) => ({
    ...review,
    id: `external-${index}`,
    tone: review.platform === "Trustpilot" ? "trustpilot" : "linkedin",
    eyebrow: "Opinión pública",
    action: "Ver original",
  })),
  ...websiteReviews.map((review) => ({
    ...review,
    platform: "Amazon Boost",
    initials: "AB",
    date: null,
    url: null,
    tone: "internal",
    eyebrow: "Experiencia compartida",
    action: "Leer completa",
  })),
  {
    id: "invitation",
    platform: "Tu experiencia",
    author: "Cliente Amazon Boost",
    initials: "+",
    meta: "Trustpilot o LinkedIn",
    date: null,
    title: "¿Has trabajado con nosotros?",
    quote: "Comparte qué problema resolvimos, cómo fue el proceso y qué cambió en tu cuenta de Amazon.",
    url: "/dejar-resena",
    tone: "invite",
    eyebrow: "Tu voz puede ser la siguiente",
    action: "Compartir experiencia",
  },
];

const sellerBars = [42, 46, 39, 24, 31, 44, 41, 32, 30, 50, 19, 35, 41, 34, 27, 26, 36, 100, 31, 22, 36, 36, 63, 30, 53, 41, 68, 73];
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { mountMacbookScroll } from "../lib/macbook-scroll";

  const initHomeExperience = async () => {
    const heroAxis = document.querySelector<HTMLElement>("[data-hero-axis]");
    const hero = document.querySelector<HTMLElement>(".ab-hero");
    if (hero) mountMacbookScroll(hero, { gsap, ScrollTrigger });
    let axisFrame = 0;
    const updateHeroAxis = () => {
      axisFrame = 0;
      const progress = Math.min(1, Math.max(0, window.scrollY / 420));
      if (heroAxis) {
        heroAxis.style.setProperty("--axis-turn", `${progress * 90}deg`);
        heroAxis.style.setProperty("--axis-scale", `${1 + progress * .5}`);
      }
    };
    updateHeroAxis();
    window.addEventListener("scroll", () => {
      if (!axisFrame) axisFrame = window.requestAnimationFrame(updateHeroAxis);
    }, { passive: true });

    const reviewMarquee = document.querySelector<HTMLElement>(".ab-review-marquee");
    const reviewPause = document.querySelector<HTMLButtonElement>("[data-review-pause]");
    reviewPause?.addEventListener("click", () => {
      const paused = reviewPause.getAttribute("aria-pressed") !== "true";
      reviewPause.setAttribute("aria-pressed", String(paused));
      reviewPause.textContent = paused ? "Reanudar reseñas" : "Pausar reseñas";
      reviewMarquee?.classList.toggle("is-paused", paused);
    });
    document.querySelectorAll<HTMLButtonElement>("[data-review-open]").forEach((button) => {
      button.addEventListener("click", () => {
        const dialog = document.getElementById(`review-${button.dataset.reviewOpen}`);
        if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
        dialog.showModal();
        reviewMarquee?.classList.add("has-dialog");
        document.documentElement.classList.add("ab-review-dialog-open");
        dialog.addEventListener("close", () => {
          reviewMarquee?.classList.remove("has-dialog");
          document.documentElement.classList.remove("ab-review-dialog-open");
          button.focus({ preventScroll: true });
        }, { once: true });
      });
    });
    document.querySelectorAll<HTMLDialogElement>(".ab-review-dialog").forEach((dialog) => {
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
      });
    });

    const reflectionHeading = document.querySelector<HTMLElement>("[data-reflection]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    let reflectionFrame = 0;
    const updateReflection = () => {
      reflectionFrame = 0;

      if (reflectionHeading && !reduceMotion) {
        const rect = reflectionHeading.getBoundingClientRect();
        const travel = clamp((window.innerHeight * .72 - rect.top) / (window.innerHeight + rect.height));
        reflectionHeading.style.setProperty("--reflection-shift", `${(travel - .5) * 6}px`);
      }
    };
    updateReflection();
    window.addEventListener("scroll", () => {
      if (!reflectionFrame) reflectionFrame = window.requestAnimationFrame(updateReflection);
    }, { passive: true });
    window.addEventListener("resize", updateReflection);

    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }
    }), { threshold: 0.12 });
    document.querySelectorAll("[data-reveal], [data-phone-rise]").forEach((element) => observer.observe(element));

    document.querySelectorAll<HTMLFormElement>(".audit-form").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const status = form.querySelector<HTMLElement>("[data-form-status]");
        const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
        if (!status || !submit) return;
        const values = Object.fromEntries(new FormData(form).entries());
        status.textContent = "Enviando solicitud..."; status.dataset.state = "sending"; submit.disabled = true;
        try {
          const [{ db }, { collection, addDoc }] = await Promise.all([
            import("../lib/firebase"),
            import("firebase/firestore"),
          ]);
          await addDoc(collection(db, "email_submissions"), { name: values.name, email: values.email, phone: values.phone || null, monthly_sales: values.monthly_sales || null, subject: "Solicitud de auditoría Amazon", message: values.message || "Quiero detectar oportunidades en mi cuenta de Amazon.", source: "home-experience-2026", status: "unread", created_at: new Date().toISOString() });
          status.textContent = "Solicitud recibida. Hablamos muy pronto."; status.dataset.state = "success"; form.reset();
        } catch (error) {
          console.error("Error al enviar la solicitud:", error); status.textContent = "No se ha podido enviar. Escríbenos a info@amznboost.es."; status.dataset.state = "error";
        } finally { submit.disabled = false; }
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHomeExperience, { once: true });
  } else {
    initHomeExperience();
  }
</script>

<section class="ab-hero" id="inicio">
  <div class="ab-hero-shell">
    <div class="ab-hero-copy" data-reveal>
      <p class="ab-overline"><span data-hero-axis></span> España · Europa · FBA · FBM</p>
      <h1><small>Agencia Amazon para marcas privadas</small><span>Amazon</span><em>Boost.</em></h1>
      <p class="ab-hero-statement">Convertimos Amazon en un canal rentable.</p>
      <p class="ab-hero-description">Hacemos que publicidad, catálogo y stock trabajen juntos para vender más sin perder rentabilidad.</p>
      <div class="ab-hero-actions">
        <a class="ab-button ab-button-primary" href="#auditoria">Solicitar auditoría <Icon name="arrow-up-right" size={18} /></a>
        <a class="ab-button ab-button-ghost" href="#caso-real">Ver un caso real <Icon name="arrow-down" size={18} /></a>
      </div>
    </div>

    <div class="ab-account-stage" data-macbook-stage>
      <div class="ab-macbook" data-hero-macbook>
        <div class="ab-macbook-lid">
          <img class="ab-macbook-device ab-macbook-device-lid" src="/images/macbook-graphite-frame.png" alt="" aria-hidden="true" />
          <div class="ab-macbook-screen">
          <div class="ab-macbook-camera" aria-hidden="true"><i></i></div>
          <div class="ab-seller-window" aria-label="Vista de ejemplo de una cuenta de Seller Central">
            <div class="ab-seller-topbar">
              <div class="ab-seller-brand"><b>amazon</b><span>seller central</span></div>
              <div class="ab-seller-search">Buscar en Seller Central</div>
              <div class="ab-seller-market">España <b>ES</b></div>
            </div>
            <div class="ab-seller-layout">
              <aside class="ab-seller-sidebar" aria-hidden="true">
                <strong>INICIO</strong><span>Pedidos</span><span>Inventario</span><span>Publicidad</span><span>Informes</span>
              </aside>
              <div class="ab-seller-dashboard">
                <div class="ab-seller-health"><i><Icon name="check" size={11} strokeWidth={3} /></i><strong>Tu tienda es saludable</strong><span><Icon name="chevron-right" size={15} /></span></div>
                <div class="ab-seller-heading">
                  <div><small>VENTAS DE PRODUCTOS</small><h2>Últimos 30 días</h2></div>
                  <span class="ab-seller-demo">Simulación visual</span>
                </div>
                <div class="ab-seller-performance">
                  <article><strong>487.930 €</strong><small>Últimos 30 días</small></article>
                  <article class="is-down"><strong>12 % <Icon name="trending-down" size={12} /></strong><small>Periodo anterior</small></article>
                  <article class="is-up"><strong>742 % <Icon name="trending-up" size={12} /></strong><small>El año pasado</small></article>
                </div>
                <div class="ab-seller-bar-chart" role="img" aria-label="Gráfico de barras de ventas diarias durante los últimos 30 días">
                  <div class="ab-seller-grid-lines"><i></i><i></i><i></i><i></i></div>
                  <div class="ab-seller-bars">{sellerBars.map((height) => <i style={`--seller-bar:${height}%`}></i>)}</div>
                  <div class="ab-seller-axis"><span>28 jul</span><span>7 ago</span><span>17 ago</span><span>26 ago</span></div>
                </div>
              </div>
            </div>
          </div>
            <span class="ab-macbook-label">MacBook Pro</span>
          </div>
        </div>
        <img class="ab-macbook-device ab-macbook-device-base" src="/images/macbook-graphite-frame.png" alt="" aria-hidden="true" />
      </div>
    </div>

  </div>
  <div class="ab-proof-rail" data-reveal>
    {homeShowcase.proof.map((item, index) => (
      <div class:list={{ "ab-proof-reviews": index === 0 }}>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        {index === 0 && (
          <a class="ab-proof-rating" href="#resenas" aria-label="Ver opiniones de clientes de Amazon Boost">
            <span class="ab-proof-stars" aria-label="Cinco estrellas">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={12} strokeWidth={1.8} filled />)}</span>
            <small>5/5 en reseñas</small>
            <Icon name="arrow-up-right" size={13} />
          </a>
        )}
      </div>
    ))}
  </div>
</section>

<div class="ab-ticker" id="especialidades" aria-label={tickerItems.join(", ")}>
  <div class="ab-ticker-track" style={`--ticker-duration:${tickerItems.length * 4.3}s`}>
    {[0, 1].map((groupIndex) => (
      <div class="ab-ticker-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
        {tickerItems.map((item) => <><span>{item}</span><i></i></>)}
      </div>
    ))}
  </div>
</div>

<section class="ab-signal-section" id="diagnostico">
  <div class="ab-section-intro" data-reveal><p class="ab-overline ab-overline-dark"><span></span> Diagnóstico inicial</p><h2><span>¿Dónde se está escapando </span><span>el crecimiento?</span></h2><p>Analizamos dónde se pierden ventas y rentabilidad para decidir qué cambiar primero.</p></div>
  <DiagnosticExperience />
</section>

<FeaturedCases />

<section class="ab-client-reviews" id="resenas">
  <div class="ab-client-reviews-heading is-unified" data-reveal>
    <p class="ab-overline ab-overline-dark"><span></span> Voces de clientes</p><h2>El resultado importa. La experiencia hasta llegar a él, también.</h2>
  </div>
  <div class="ab-review-marquee" data-reveal aria-label="Opiniones y experiencias de clientes" style={`--review-duration:${reviewRail.length * 12}s`}>
    <div class="ab-review-track">
      {[0, 1].map((groupIndex) => (
        <div class="ab-review-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
          {reviewRail.map((review) => {
            if (review.tone !== "invite") return <ReviewCard review={review} duplicate={groupIndex === 1} />;
            return (
            <a class="ab-client-review-card is-invite" href={review.url ?? undefined} tabindex={groupIndex === 1 ? -1 : undefined}>
              <div class="ab-client-review-top"><span>{review.initials}</span><div><strong>{review.platform}</strong><small>{review.eyebrow}</small></div></div>
              <blockquote><strong>{review.title}</strong><p>“{review.quote}”</p></blockquote>
              <footer><div><strong>{review.author}</strong><small>{review.meta}</small></div><span>{review.action} <Icon name="arrow-up-right" size={14} /></span></footer>
            </a>
          );})}
        </div>
      ))}
    </div>
  </div>
  <div class="ab-review-actions" data-reveal><button class="ab-review-pause" type="button" data-review-pause aria-pressed="false">Pausar reseñas</button><a href="/dejar-resena">Compartir mi experiencia <Icon name="arrow-up-right" size={17} /></a><a href="https://es.trustpilot.com/review/amznboost.es" target="_blank" rel="noreferrer">Ver Trustpilot <Icon name="arrow-up-right" size={17} /></a></div>
  {websiteReviews.map((review) => (
    <dialog class="ab-review-dialog" id={`review-${review.id}`} aria-labelledby={`review-title-${review.id}`}>
      <form method="dialog"><button type="submit" aria-label="Cerrar reseña" title="Cerrar reseña"><Icon name="x" size={20} /></button></form>
      <p class="ab-review-dialog-source">Experiencia compartida</p>
      <h3 id={`review-title-${review.id}`}>{review.title}</h3>
      <blockquote><p>“{review.quote}”</p></blockquote>
      <footer><strong>{review.author}</strong><span>{review.meta}</span></footer>
    </dialog>
  ))}
</section>

<section class="ab-services-section" id="services">
  <div class="ab-section-intro ab-services-intro" data-reveal><p class="ab-overline ab-overline-dark"><span></span> El sistema Amazon Boost</p><h2 data-reflection="No gestionamos piezas sueltas. Gestionamos el mecanismo completo.">No gestionamos piezas sueltas. Gestionamos el mecanismo completo.</h2></div>
