---
import { buildPageSchema } from '../lib/structured-data';

interface Props {
  type?: 'organization' | 'article' | 'service' | 'breadcrumb';
  data?: {
    title?: string;
    description?: string;
    image?: string | null;
    date?: string;
    dateModified?: string;
  };
  url: string;
  title: string;
  description: string;
  image?: string | null;
  pageType?: string;
}

const { type = 'organization', data, url, title, description, image, pageType } = Astro.props;
const schema = buildPageSchema({ type, data, url, title, description, image, pageType });
---
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
