---
interface Props {
  review: {
    id: string;
    platform: string;
    author: string;
    initials: string;
    meta: string;
    date: string | null;
    title: string;
    quote: string;
    url: string | null;
    fullQuote?: string;
    publishedAt?: string;
    context?: string;
    rating?: number;
  };
  duplicate?: boolean;
}

const { review, duplicate = false } = Astro.props;
const trustpilot = review.platform === "Trustpilot";
const internal = review.platform === "Amazon Boost";
const Card = internal ? "article" : "a";
const source = internal ? null : trustpilot ? review.context : "Recomendación en LinkedIn";
---

<Card class:list={["ab-client-review-card", "ab-review-unified", internal ? "is-internal" : trustpilot ? "is-trustpilot" : "is-linkedin"]} href={internal ? undefined : review.url ?? undefined} target={internal ? undefined : "_blank"} rel={internal ? undefined : "noopener noreferrer"} tabindex={!internal && duplicate ? -1 : undefined}>
  <div class="ab-review-source">
    {trustpilot
      ? <img class="ab-platform-wordmark" src="/icons/brands/trustpilot-logo.svg" alt="Trustpilot" width="108" height="27" loading="lazy" />
      : <span class="ab-platform-brand"><img src={internal ? "/favicon.svg" : "/icons/brands/linkedin-in.png"} alt="" width="26" height="26" loading="lazy" />{review.platform}</span>}
    {review.date && <time datetime={review.publishedAt}>{review.date}</time>}
  </div>
  <div class="ab-review-author">
    <span class="ab-review-avatar" aria-hidden="true">{review.initials}</span>
    <div><strong>{review.author}</strong><small>{review.meta}</small></div>
  </div>
  <div class="ab-review-context">
    {trustpilot
      ? <img class="ab-platform-stars" src="/icons/brands/trustpilot-stars-5.svg" alt={`${review.rating ?? 5} de 5 estrellas`} width="108" height="20" loading="lazy" />
      : <p>{internal ? "Experiencia compartida" : review.context}</p>}
  </div>
  <blockquote>
    <strong>{review.title}</strong>
    <p>{review.fullQuote ?? review.quote}</p>
  </blockquote>
  <footer>
    {source && <span>{source}</span>}
    {internal
      ? <button class="ab-review-original" type="button" data-review-open={review.id} aria-haspopup="dialog" aria-controls={`review-${review.id}`} aria-label={`Leer reseña completa: ${review.title}`} tabindex={duplicate ? -1 : undefined}>Leer completa <img src="/icons/lucide/arrow-right.svg" alt="" width="16" height="16" /></button>
      : <span class="ab-review-original">Ver original <img src="/icons/lucide/arrow-right.svg" alt="" width="16" height="16" /></span>}
  </footer>
</Card>

<style>
  .ab-client-review-card.ab-review-unified {
    --accent: var(--ab-orange);
    --mx: 50%;
    --my: 0%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 28px 60px 24px minmax(0, 1fr) 44px;
    gap: 12px;
    height: 440px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 10px;
    background: linear-gradient(160deg, #17181a, #0d0e0f 70%);
    color: #f5f5f0;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .35);
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease, opacity .25s ease;
    will-change: transform;
  }
  .ab-review-unified.is-trustpilot { --accent: #00b67a; }
  .ab-review-unified.is-linkedin { --accent: #4a9bea; }
  /* Accent line on top and a light that follows the cursor. */
  .ab-review-unified::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--accent), transparent 75%); }
  .ab-review-unified::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%); transition: opacity .25s ease; }
  .ab-review-unified > * { position: relative; z-index: 1; }
  .ab-review-unified.is-lit, .ab-review-unified:focus-visible { border-color: color-mix(in srgb, var(--accent) 65%, transparent); box-shadow: 0 26px 60px rgba(0, 0, 0, .55), 0 0 44px color-mix(in srgb, var(--accent) 16%, transparent); }
  .ab-review-unified.is-lit { transition: border-color .25s ease, box-shadow .25s ease, opacity .25s ease; }
  .ab-review-unified.is-lit::after { opacity: 1; }
  :global(.ab-review-marquee:has(.is-lit)) .ab-review-unified:not(.is-lit) { opacity: .5; }
  .ab-client-review-card.ab-review-unified:hover { transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); }
  .ab-review-source { display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:27px; }
  .ab-review-source img { display:block;object-fit:contain; }
  .ab-platform-wordmark { box-sizing:content-box;width:92px;height:23px;padding:3px 8px;border-radius:4px;background:#fff; }
  .ab-platform-brand { display:flex;align-items:center;gap:9px;font-size:.85rem;font-weight:700; }
  .ab-platform-brand img { width:26px;height:26px;border-radius:4px; }
  .ab-review-source time { flex:none;color:#8d8e88;font-size:.68rem; }
  .ab-review-author { display:grid;grid-template-columns:40px minmax(0,1fr);gap:12px;align-items:center; }
  .ab-review-avatar { display:grid;place-items:center;width:40px;height:40px;border:1px solid color-mix(in srgb, var(--accent) 55%, transparent);border-radius:50%;background:color-mix(in srgb, var(--accent) 14%, #111);color:#fff;font-size:.8rem;font-weight:700; }
  .ab-review-author strong { display:block;font-size:.9rem;font-weight:700;line-height:1.35; }
  .ab-review-author small { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:3px;color:#a2a39d;font-size:.72rem;line-height:1.4; }
  .ab-review-context { display:flex;align-items:center;min-width:0; }
  .ab-platform-stars { display:block;width:108px;height:20px;object-fit:contain; }
  .ab-review-context p { margin:0;color:var(--accent);font-size:.66rem;font-weight:800;line-height:1.4;text-transform:uppercase; }
  .ab-review-unified blockquote { min-height:0;margin:0;overflow:hidden; }
  .ab-review-unified blockquote strong { display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;color:#fff;font-size:1.12rem;line-height:1.3;font-weight:800; }
  .ab-review-unified blockquote p { margin:10px 0 0;color:#c9cac4;opacity:1;font-size:.88rem;line-height:1.55;-webkit-line-clamp:4; }
  .ab-review-unified footer { align-items:center;gap:12px;margin:0;padding-top:0;border-top:1px solid rgba(255,255,255,.12); }
  .ab-review-unified footer>span { color:#8d8e88;font-size:.64rem;line-height:1.4;font-weight:400;text-transform:none; }
  .ab-review-unified footer>.ab-review-original { display:flex;flex:none;align-items:center;gap:7px;min-height:44px;margin-left:auto;color:#fff;font-size:.72rem;font-weight:700; }
  .ab-review-original img { display:block;filter:invert(1);transition:transform .2s ease; }
  .ab-review-unified.is-lit .ab-review-original, .ab-review-unified:hover .ab-review-original { color:var(--accent);text-decoration:none; }
  .ab-review-unified:hover .ab-review-original img { transform:translateX(4px); }
  @media(max-width:760px) { .ab-client-review-card.ab-review-unified { padding:20px; } }
  @media(prefers-reduced-motion:reduce) { .ab-client-review-card.ab-review-unified { transform:none;transition:none; } }
</style>
