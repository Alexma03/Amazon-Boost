---
interface Props {
  review: {
    id: string;
    platform: string;
    author: string;
    initials: string;
    meta: string;
    date: string | null;
    title: string;
    quote: string;
    url: string | null;
    fullQuote?: string;
    publishedAt?: string;
    context?: string;
  };
  duplicate?: boolean;
}

const { review, duplicate = false } = Astro.props;
const trustpilot = review.platform === "Trustpilot";
const internal = review.platform === "Amazon Boost";
const Card = internal ? "article" : "a";
const source = internal ? null : trustpilot ? review.context : "Recomendación en LinkedIn";
---

<Card class:list={["ab-client-review-card", "ab-review-unified", internal ? "is-internal" : trustpilot ? "is-trustpilot" : "is-linkedin"]} href={internal ? undefined : review.url ?? undefined} target={internal ? undefined : "_blank"} rel={internal ? undefined : "noopener noreferrer"} tabindex={!internal && duplicate ? -1 : undefined}>
  <div class="ab-review-source">
    {trustpilot
      ? <img class="ab-platform-wordmark" src="/icons/brands/trustpilot-logo.svg" alt="Trustpilot" width="108" height="27" loading="lazy" />
      : <span class="ab-platform-brand"><img src={internal ? "/favicon.svg" : "/icons/brands/linkedin-in.png"} alt="" width="26" height="26" loading="lazy" />{review.platform}</span>}
    {review.date && <time datetime={review.publishedAt}>{review.date}</time>}
  </div>
  <div class="ab-review-author">
    <span class="ab-review-avatar" aria-hidden="true">{review.initials}</span>
    <div><strong>{review.author}</strong><small>{review.meta}</small></div>
  </div>
  <div class="ab-review-context">
    {trustpilot
      ? <img class="ab-platform-stars" src="/icons/brands/trustpilot-stars-5.svg" alt="5 de 5 estrellas" width="108" height="20" loading="lazy" />
      : <p>{internal ? "Experiencia compartida" : review.context}</p>}
  </div>
  <blockquote>
    <strong>{review.title}</strong>
    <p>{review.fullQuote ?? review.quote}</p>
  </blockquote>
  <footer>
    {source && <span>{source}</span>}
    {internal
      ? <button class="ab-review-original" type="button" data-review-open={review.id} aria-haspopup="dialog" aria-controls={`review-${review.id}`} aria-label={`Leer reseña completa: ${review.title}`} tabindex={duplicate ? -1 : undefined}>Leer completa <img src="/icons/lucide/arrow-right.svg" alt="" width="16" height="16" /></button>
      : <span class="ab-review-original">Ver original <img src="/icons/lucide/arrow-right.svg" alt="" width="16" height="16" /></span>}
  </footer>
</Card>

<style>
  .ab-client-review-card.ab-review-unified {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 28px 60px 24px minmax(0, 1fr) 44px;
    gap: 12px;
    height: 440px;
    padding: 22px;
    background: #fff;
    color: #202420;
    border-color: #d9ddd9;
    box-shadow: 0 3px 12px rgba(17, 17, 17, .035);
  }
  .ab-review-source { display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:27px; }
  .ab-review-source img { display:block;object-fit:contain; }
  .ab-platform-wordmark { width:108px;height:27px; }
  .ab-platform-brand { display:flex;align-items:center;gap:9px;font-size:.85rem;font-weight:700; }
  .ab-platform-brand img { width:26px;height:26px;border-radius:4px; }
  .ab-review-source time { flex:none;color:#687068;font-size:.68rem; }
  .ab-review-author { display:grid;grid-template-columns:40px minmax(0,1fr);gap:12px;align-items:center; }
  .ab-review-avatar { display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#edf0f2;color:#39414a;font-size:.83rem; }
  .ab-review-author strong { display:block;font-size:.87rem;font-weight:700;line-height:1.35; }
  .ab-review-author small { display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:3px;color:#667066;font-size:.7rem;line-height:1.4; }
  .ab-review-context { display:flex;align-items:center;min-width:0; }
  .ab-platform-stars { display:block;width:108px;height:20px;object-fit:contain; }
  .ab-review-context p { margin:0;color:#697269;font-size:.7rem;line-height:1.4; }
  .ab-review-unified blockquote { min-height:0;margin:0;overflow:hidden; }
  .ab-review-unified blockquote strong { display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:1.03rem;line-height:1.35;font-weight:700; }
  .ab-review-unified blockquote p { margin:10px 0 0;color:#353b35;opacity:1;font-size:.87rem;line-height:1.5;-webkit-line-clamp:4; }
  .ab-review-unified footer { align-items:center;gap:12px;margin:0;padding-top:0;border-top:1px solid #e8ebe7; }
  .ab-review-unified footer>span { color:#697269;font-size:.62rem;line-height:1.4;font-weight:400;text-transform:none; }
  .ab-review-unified footer>.ab-review-original { display:flex;flex:none;align-items:center;gap:7px;min-height:44px;margin-left:auto;color:#202420;font-size:.7rem;font-weight:700; }
  .ab-review-original img { display:block; }
  .ab-review-unified:hover .ab-review-original { text-decoration:underline;text-underline-offset:3px; }
  @media(max-width:760px) { .ab-client-review-card.ab-review-unified { padding:19px; } }
</style>
