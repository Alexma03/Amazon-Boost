---
import Icon from "./Icon.astro";

const isAdminPage = Astro.url.pathname.startsWith("/admin");
const currentPath = Astro.url.pathname;

const navItems = [
  { text: "Caso real", href: "/casos-de-exito/", match: "/casos-de-exito" },
  { text: "Servicios", href: "/servicios/", match: "/servicios" },
];

const resourceItems = [
  { text: "Guías", href: "/guias/" },
  { text: "Blog", href: "/blog/" },
];

const isActive = (match: string) => currentPath === `${match}/` || currentPath.startsWith(`${match}/`);
const resourcesActive = currentPath.startsWith("/guias/") || currentPath.startsWith("/blog/");
---

<header class="ab-site-header" data-site-header>
  <div class="ab-header-inner">
    <a href="/" class="ab-brand" aria-label="Amazon Boost, inicio">
      <img class="ab-brand-symbol" src="/favicon.svg" alt="" />
      <span>Amazon Boost<em>.</em></span>
    </a>

    {isAdminPage ? (
      <button id="signOutButton" class="ab-header-action">Cerrar sesión <Icon name="arrow-up-right" size={17} /></button>
    ) : (
      <>
        <nav class="ab-desktop-nav" aria-label="Navegación principal">
          {navItems.map((item) => <a href={item.href} class:list={{ "is-active": isActive(item.match) }} aria-current={isActive(item.match) ? "page" : undefined}>{item.text}</a>)}
          <details class:list={["ab-resource-menu", { "is-active": resourcesActive }]} data-resource-menu>
            <summary>Recursos <Icon name="chevron-down" size={15} /></summary>
            <div class="ab-resource-popover">
              {resourceItems.map((item) => <a href={item.href}>{item.text}<Icon name="arrow-up-right" size={15} /></a>)}
            </div>
          </details>
        </nav>
        <a class="ab-header-action ab-desktop-action" href="/#auditoria">Auditoría gratis <Icon name="arrow-up-right" size={17} /></a>
        <button class="ab-menu-button" id="menuButton" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
          <span></span><span></span><span></span>
        </button>
      </>
    )}
  </div>

  {!isAdminPage && (
    <nav class="ab-mobile-menu" id="mobileMenu" aria-label="Navegación móvil">
      {navItems.map((item) => <a href={item.href} aria-current={isActive(item.match) ? "page" : undefined}>{item.text}<Icon name="arrow-up-right" size={18} /></a>)}
      <details class="ab-mobile-resources">
        <summary>Recursos <Icon name="chevron-down" size={18} /></summary>
        <div>{resourceItems.map((item) => <a href={item.href}>{item.text}<Icon name="arrow-up-right" size={17} /></a>)}</div>
      </details>
      <a class="ab-mobile-cta" href="/#auditoria">Solicitar auditoría <Icon name="arrow-up-right" size={18} /></a>
    </nav>
  )}
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const menuButton = document.querySelector<HTMLButtonElement>("#menuButton");
  const mobileMenu = document.querySelector<HTMLElement>("#mobileMenu");
  const resourceMenu = document.querySelector<HTMLDetailsElement>("[data-resource-menu]");

  const closeMenu = () => {
    mobileMenu?.classList.remove("open");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Abrir menú");
    mobileMenu?.querySelectorAll("details").forEach((details) => details.removeAttribute("open"));
  };

  menuButton?.addEventListener("click", () => {
    const willOpen = !mobileMenu?.classList.contains("open");
    mobileMenu?.classList.toggle("open", willOpen);
    menuButton.setAttribute("aria-expanded", String(willOpen));
    menuButton.setAttribute("aria-label", willOpen ? "Cerrar menú" : "Abrir menú");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("click", (event) => {
    if (resourceMenu?.open && event.target instanceof Node && !resourceMenu.contains(event.target)) resourceMenu.removeAttribute("open");
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !resourceMenu?.open) return;
    resourceMenu.removeAttribute("open");
    resourceMenu.querySelector("summary")?.focus();
  });
  window.addEventListener("scroll", () => header?.classList.toggle("scrolled", window.scrollY > 16), { passive: true });

  document.querySelector("#signOutButton")?.addEventListener("click", async () => {
    try {
      const [{ auth }, { signOut }] = await Promise.all([import("../lib/firebase"), import("firebase/auth")]);
      await signOut(auth);
      window.location.href = "/";
    } catch (error) {
      console.error("No se ha podido cerrar sesión:", error);
    }
  });
</script>

<style>
  .ab-site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 64px;
    color: #fff;
    background: rgba(11, 11, 11, 0.96);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
    transition: background 180ms ease;
  }

  .ab-site-header.scrolled { background: rgba(18, 18, 18, 0.96); }

  .ab-header-inner {
    width: min(1440px, 100%);
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
  }

  .ab-brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 10px;
    color: #fff;
    font-size: 1rem;
    font-weight: 850;
  }

  .ab-brand em { color: #ff9900; font-style: normal; }
  .ab-brand-symbol { width: 34px; height: 34px; display: block; border-radius: 4px; object-fit: cover; }
  .ab-desktop-nav { display: flex; align-items: center; gap: 28px; }
  .ab-desktop-nav > a, .ab-resource-menu > summary { position: relative; min-height: 64px; display: inline-flex; align-items: center; gap: 6px; padding: 2px 0 0; color: #e8e8e5; font-size: .82rem; font-weight: 750; list-style: none; cursor: pointer; }
  .ab-resource-menu > summary::-webkit-details-marker { display: none; }
  .ab-desktop-nav > a::after, .ab-resource-menu > summary::after { content: ""; position: absolute; right: 0; bottom: 12px; left: 0; height: 2px; background: #ff9900; transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  .ab-desktop-nav > a:hover, .ab-resource-menu > summary:hover { color: #fff; }
  .ab-desktop-nav > a:hover::after, .ab-desktop-nav > a.is-active::after, .ab-resource-menu > summary:hover::after, .ab-resource-menu.is-active > summary::after, .ab-resource-menu[open] > summary::after { transform: scaleX(1); }
  .ab-resource-menu { position: relative; }
  .ab-resource-menu > summary .ab-icon { transition: transform 180ms ease; }
  .ab-resource-menu[open] > summary .ab-icon { transform: rotate(180deg); }
  .ab-resource-popover { position: absolute; top: 55px; left: 50%; width: 218px; padding: 7px; background: #121212; border: 1px solid rgba(255,255,255,.14); border-radius: 6px; box-shadow: 0 18px 44px rgba(0,0,0,.34); transform: translateX(-50%); }
  .ab-resource-popover a { min-height: 42px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; border-radius: 4px; color: #d8d8d5; font-size: .78rem; font-weight: 730; }
  .ab-resource-popover a:hover { background: rgba(255,255,255,.07); color: #fff; }

  .ab-header-action {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    justify-self: end;
    gap: 20px;
    padding: 0 13px;
    border: 0;
    border-radius: 4px;
    background: #ff9900;
    color: #111;
    font-size: .72rem;
    font-weight: 850;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .ab-header-action:hover { background: #fff; color: #111; transform: translateY(-1px); }
  .ab-site-header a:focus-visible,.ab-site-header button:focus-visible,.ab-site-header summary:focus-visible { outline: 2px solid #ff9900; outline-offset: 4px; }
  .ab-menu-button { display: none; width: 39px; height: 39px; padding: 10px; border: 1px solid rgba(255,255,255,.18); border-radius: 4px; background: transparent; cursor: pointer; }
  .ab-menu-button span { display: block; width: 100%; height: 2px; margin: 4px 0; background: #fff; transition: transform 180ms ease, opacity 180ms ease; }
  .ab-menu-button[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .ab-menu-button[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .ab-menu-button[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .ab-mobile-menu { display: none; position: absolute; top: 64px; right: 0; left: 0; padding: 10px 16px 18px; background: #0b0b0b; border-bottom: 1px solid rgba(255,255,255,.14); }
  .ab-mobile-menu > a { min-height: 52px; display: flex; align-items: center; justify-content: space-between; color: #fff; border-bottom: 1px solid rgba(255,255,255,.12); font-size: 1rem; font-weight: 750; }
  .ab-mobile-resources { border-bottom: 1px solid rgba(255,255,255,.12); }
  .ab-mobile-resources summary { min-height: 52px; display: flex; align-items: center; justify-content: space-between; color: #fff; font-size: 1rem; font-weight: 750; list-style: none; cursor: pointer; }
  .ab-mobile-resources summary::-webkit-details-marker { display: none; }
  .ab-mobile-resources summary .ab-icon { transition: transform 180ms ease; }
  .ab-mobile-resources[open] summary .ab-icon { transform: rotate(180deg); }
  .ab-mobile-resources div { display: grid; padding: 0 0 9px 13px; }
  .ab-mobile-resources a { min-height: 44px; display: flex; align-items: center; justify-content: space-between; color: #bfc0bc; font-size: .9rem; font-weight: 700; }
  .ab-mobile-menu .ab-mobile-cta { margin-top: 12px; padding: 0 14px; border: 0; border-radius: 4px; background: #ff9900; color: #111; }

  @media (max-width: 900px) {
    .ab-header-inner { grid-template-columns: 1fr auto; padding: 0 16px; }
    .ab-desktop-nav, .ab-desktop-action { display: none; }
    .ab-menu-button { display: block; }
    .ab-mobile-menu.open { display: grid; }
  }
</style>
