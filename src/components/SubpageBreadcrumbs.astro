---
interface Props { items: { name: string; path: string }[] }
import { canonicalPageUrl, shouldNoindex } from '../data/site-index';
import { buildBreadcrumbSchema } from '../lib/structured-data';
const { items } = Astro.props;
const schema = buildBreadcrumbSchema(canonicalPageUrl(Astro.url.pathname), items);
---
<nav class="growth-breadcrumbs" aria-label="Ruta de navegación">
  <ol>{items.map((item, index) => <li>{index === items.length - 1
    ? <span aria-current="page">{item.name}</span>
    : <a href={item.path}>{item.name}</a>}</li>)}</ol>
</nav>
{!shouldNoindex(Astro.url.pathname) && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
