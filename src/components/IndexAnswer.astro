---
// Direct question-and-answer block for index pages, plus an ItemList of what the page links to.
// It gives search engines and AI assistants a self-contained summary with its source.
import { siteUrl } from '../data/site-index';

interface Props {
  question: string;
  answer: string;
  listName: string;
  items: { name: string; path: string }[];
}

const { question, answer, listName, items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: listName,
  numberOfItems: items.length,
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: new URL(item.path, siteUrl).href,
  })),
};
---

<section class="index-answer" aria-labelledby="index-answer-title">
  <div class="growth-shell">
    <h2 id="index-answer-title">{question}</h2>
    <p>{answer}</p>
    <small>Fuente: Amazon Boost.</small>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />

<style>
  .index-answer { padding: 34px 0 6px; }
  .index-answer h2 { max-width: 820px; margin: 0 0 12px; font-size: 1.35rem; line-height: 1.3; font-weight: 800; }
  .index-answer p { max-width: 820px; margin: 0; font-size: 1rem; line-height: 1.7; opacity: .82; }
  .index-answer small { display: block; margin-top: 10px; font-size: .76rem; opacity: .6; }
</style>
