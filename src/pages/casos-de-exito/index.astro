---
import Layout from '../../layouts/Layout.astro';
import SubpageBreadcrumbs from '../../components/SubpageBreadcrumbs.astro';
import CaseSummary from '../../components/CaseSummary.astro';
import ServiceContact from '../../components/ServiceContact.astro';
import { featuredCaseStudies } from '../../data/case-studies/catalogue';
import '../../styles/growth-pages.css';
import '../../styles/case-studies.css';

export const prerender = true;
const title = 'Casos de éxito en Amazon | Amazon Boost';
const description = 'Marcas distintas, retos concretos y decisiones conectadas. Conoce el trabajo detrás del crecimiento orgánico y la gestión integral de Amazon Boost.';
---
<Layout title={title} description={description} canonicalPath="/casos-de-exito/" pageType="case-study" aiOptimized={false}>
  <article class="growth-page case-page">
    <header class="growth-hero case-index-hero">
      <div class="growth-shell">
        <SubpageBreadcrumbs items={[{ name: 'Inicio', path: '/' }, { name: 'Casos de éxito', path: '/casos-de-exito/' }]} />
        <p class="growth-eyebrow">Casos de éxito / Amazon Boost</p>
        <h1>La estrategia se demuestra en la cuenta.</h1>
        <p class="case-hero-lead">Marcas distintas. Retos concretos. Descubre cómo conectamos contenido, publicidad y operativa para convertir decisiones en crecimiento dentro de Amazon.</p>
        <div class="growth-actions"><a class="growth-button" href="#casos">Explorar los casos <img src="/icons/lucide/arrow-right.svg" width="20" height="20" alt="" /></a></div>
      </div>
    </header>
    <section class="case-manifesto"><div class="growth-shell">
      <p>Lo importante no es una métrica aislada.</p>
      <h2>Es entender qué decisiones hicieron posible moverla.</h2>
    </div></section>
    <section class="case-featured-list" id="casos" aria-label="Casos destacados"><div class="growth-shell">
      {featuredCaseStudies.map((study) => <CaseSummary study={study} />)}
    </div></section>
    <ServiceContact topic="la estrategia de mi cuenta Amazon" preparation={['Tu marca y el catálogo con el que trabajas.', 'El principal reto que necesitas resolver.', 'Qué parte del canal te gustaría delegar.']} />
  </article>
</Layout>
