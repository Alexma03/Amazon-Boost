---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { allCaseStudies, type CaseStudy } from '../../data/case-studies/catalogue';

export const prerender = true;
export function getStaticPaths() {
  return allCaseStudies.map((caseStudy) => ({ params: { slug: caseStudy.slug }, props: { caseStudy } }));
}
interface Props { caseStudy: CaseStudy }
const { caseStudy } = Astro.props;
---
<CaseStudyLayout caseStudy={caseStudy} />
