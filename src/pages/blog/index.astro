---
import Layout from '../../layouts/Layout.astro';
import type { BlogPostPreview } from '../../data/blog-data';
import { posts } from '../../data/blog-data';
import '../../styles/subpage-redesign.css';

export const prerender = true;
const [featured, ...articles] = posts;
const formatDate = (date: string) => new Date(date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Recursos para vender en Amazon | Blog Amazon Boost" description="Análisis y estrategias sobre Amazon SEO, PPC, listings, conversión y gestión de cuenta.">
  <article class="sub-page blog-page">
    <section class="blog-hero">
      <div class="sub-hero-grid" aria-hidden="true"></div>
      <div class="sub-shell blog-hero-layout">
        <div>
          <p class="sub-kicker"><i></i> Amazon Boost / Recursos</p>
          <h1>Decisiones mejores para vender en Amazon.</h1>
        </div>
        <div>
          <p>Análisis prácticos sobre posicionamiento, publicidad, catálogo y conversión. Ideas para responsables de marcas que necesitan entender qué mover y por qué.</p>
          <label class="blog-search">
            <span class="sr-only">Buscar artículos</span>
            <input type="search" placeholder="Buscar por tema" data-blog-search />
            <b aria-hidden="true">⌕</b>
          </label>
        </div>
      </div>
      <div class="sub-hero-rail"><span>SEO Amazon</span><i></i><span>Amazon Ads</span><i></i><span>Conversión</span><i></i><span>Seller Central</span></div>
    </section>

    {featured && (
      <section class="blog-featured" data-blog-card data-search-text={`${featured.title} ${featured.excerpt}`}>
        <div class="sub-shell blog-featured-layout">
          <a class="blog-featured-image" href={`/blog/${featured.slug}/`}><img src={featured.image} alt={featured.title} /></a>
          <div>
            <p>Lectura destacada / {formatDate(featured.date)}</p>
            <h2><a href={`/blog/${featured.slug}/`}>{featured.title}</a></h2>
            <p>{featured.excerpt}</p>
            <a class="blog-read" href={`/blog/${featured.slug}/`}>Leer análisis <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    )}

    <section class="blog-library">
      <div class="sub-shell">
        <header class="blog-library-head"><div><p>Biblioteca</p><h2>Todos los análisis</h2></div><span data-blog-count>{articles.length} artículos</span></header>
        <div class="blog-grid">
          {articles.map((post: BlogPostPreview) => (
            <article data-blog-card data-search-text={`${post.title} ${post.excerpt}`}>
              <a class="blog-card-image" href={`/blog/${post.slug}/`}><img src={post.image} alt={post.title} loading="lazy" /></a>
              <div>
                <time datetime={post.date}>{formatDate(post.date)}</time>
                <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
                <a class="blog-read" href={`/blog/${post.slug}/`}>Leer artículo <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
        <p class="blog-empty" hidden data-blog-empty>No hay artículos que coincidan con esta búsqueda.</p>
      </div>
    </section>

    <section class="sub-final"><div class="sub-shell"><div><p>De la lectura a la cuenta</p><h2>Detectemos la próxima decisión rentable.</h2></div><a href="/#auditoria">Solicitar auditoría <span aria-hidden="true">↗</span></a></div></section>
  </article>
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-card]')];
  const count = document.querySelector<HTMLElement>('[data-blog-count]');
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
  search?.addEventListener('input', () => {
    const query = search.value.trim().toLocaleLowerCase('es');
    let visible = 0;
    cards.forEach((card) => {
      const matches = (card.dataset.searchText || '').toLocaleLowerCase('es').includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'artículo' : 'artículos'}`;
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style>
  .blog-hero{position:relative;overflow:hidden;background:#090909;color:#fff}.blog-hero-layout{position:relative;z-index:1;min-height:650px;display:grid;grid-template-columns:1.12fr .62fr;gap:100px;align-items:center;padding:70px 0}.blog-hero h1{max-width:920px;margin:0;font-size:clamp(4rem,7vw,7.7rem);line-height:.87;font-weight:850}.blog-hero-layout>div:last-child>p{margin:0;color:#adafa9;line-height:1.7}.blog-search{height:56px;display:grid;grid-template-columns:1fr auto;align-items:center;margin-top:34px;border:1px solid #3a3a3a;background:#121212}.blog-search input{width:100%;height:100%;padding:0 17px;border:0;outline:0;background:transparent;color:#fff}.blog-search b{padding:0 17px;color:#ff9900;font-size:1.4rem}.blog-featured{padding:105px 0;background:#ff9900;color:#111}.blog-featured-layout{display:grid;grid-template-columns:1fr .82fr;gap:72px;align-items:center}.blog-featured-image{display:block;aspect-ratio:16/10;overflow:hidden;background:#111}.blog-featured-image img{width:100%;height:100%;object-fit:cover}.blog-featured-layout>div>p:first-child,.blog-library-head p{margin:0 0 20px;font-size:.61rem;font-weight:850;text-transform:uppercase}.blog-featured h2{margin:0;font-size:clamp(2.8rem,4.7vw,5.2rem);line-height:.94}.blog-featured h2 a{color:#111}.blog-featured-layout>div>p:nth-of-type(2){max-width:620px;margin:25px 0;color:#3f2b0d;line-height:1.65}.blog-read{display:inline-flex;align-items:center;gap:28px;padding-bottom:5px;border-bottom:1px solid currentColor;color:inherit;font-size:.72rem;font-weight:850}.blog-library{padding:110px 0;background:#f4f4ef}.blog-library-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:48px}.blog-library-head h2{margin:0;font-size:clamp(3rem,5vw,5.5rem);line-height:.94}.blog-library-head>span{color:#71736d;font-size:.7rem}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #cecec8;border-left:1px solid #cecec8}.blog-grid>article{min-width:0;border-right:1px solid #cecec8;border-bottom:1px solid #cecec8}.blog-card-image{display:block;aspect-ratio:16/10;overflow:hidden;background:#111}.blog-card-image img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}.blog-card-image:hover img{transform:scale(1.025)}.blog-grid>article>div{padding:24px}.blog-grid time{color:#a46100;font-size:.58rem;font-weight:850;text-transform:uppercase}.blog-grid h3{margin:45px 0 14px;font-size:1.55rem;line-height:1.05}.blog-grid h3 a{color:#111}.blog-grid p{display:-webkit-box;min-height:76px;margin:0 0 28px;color:#5a5c56;font-size:.8rem;line-height:1.6;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.blog-empty{padding:50px 0;color:#5b5d57;text-align:center}
  @media(max-width:1000px){.blog-hero-layout,.blog-featured-layout{grid-template-columns:1fr;gap:45px}.blog-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:700px){.blog-hero-layout{min-height:auto;padding:75px 0 58px}.blog-hero h1{font-size:clamp(3.15rem,14vw,4.6rem)}.blog-featured,.blog-library{padding:72px 0}.blog-featured h2,.blog-library-head h2{font-size:clamp(2.7rem,11.5vw,3.8rem)}.blog-library-head{align-items:start;flex-direction:column}.blog-grid{grid-template-columns:1fr}.blog-grid h3{margin-top:30px}}
</style>
