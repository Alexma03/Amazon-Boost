---
import Layout from '../../layouts/Layout.astro';
import SubpageBreadcrumbs from '../../components/SubpageBreadcrumbs.astro';
import ResourceNav from '../../components/ResourceNav.astro';
import BlogCard from '../../components/BlogCard.astro';
import ServiceContact from '../../components/ServiceContact.astro';
import { allBlogPosts } from '../../data/blog';
import '../../styles/growth-pages.css';
import '../../styles/blog.css';

export const prerender = true;
const categories = [...new Set(allBlogPosts.map((post) => post.category))];
---
<Layout title="Blog Amazon Boost: SEO, publicidad y estrategia para marcas" description="Análisis para marcas que venden en Amazon: SEO, PPC, conversión, reseñas y expansión. Criterios para decidir y guías para llevar cada tema a tu cuenta." canonicalPath="/blog/" aiOptimized={false}>
  <div class="growth-page blog-page" data-blog-library>
    <header class="growth-hero blog-index-hero"><div class="growth-shell">
      <SubpageBreadcrumbs items={[{ name: 'Inicio', path: '/' }, { name: 'Blog', path: '/blog/' }]} />
      <p class="growth-eyebrow">Estrategia para marcas</p>
      <h1>Blog Amazon Boost.</h1>
      <p class="growth-promise">Más criterio.<br />Mejores decisiones.</p>
      <p class="growth-lead">SEO, publicidad, conversión y crecimiento. Una mirada completa al canal para entender qué mover, cuándo y por qué.</p>
      <ResourceNav current="blog" />
    </div></header>
    <section class="blog-library"><div class="growth-shell">
      <div class="blog-library-head"><h2>Todos los análisis</h2><p data-blog-count role="status" aria-live="polite" aria-atomic="true">{allBlogPosts.length} artículos</p></div>
      <form class="blog-filters" role="search" aria-label="Buscar en el blog" data-blog-form>
        <label for="blog-search">Buscar artículos<input id="blog-search" type="search" placeholder="SEO, PPC, reseñas..." autocomplete="off" data-blog-search /></label>
        <label for="blog-category">Tema<select id="blog-category" data-blog-category><option value="">Todos los temas</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <button type="button" data-blog-reset disabled>Restablecer</button>
      </form>
      <div class="blog-grid">{allBlogPosts.map((post) => <BlogCard post={post} filterable />)}</div>
      <p class="blog-empty" hidden data-blog-empty>No hay artículos que coincidan con esta búsqueda.</p>
    </div></section>
    <section class="growth-band blog-guide-bridge"><div class="growth-shell">
      <div><p class="growth-eyebrow">De la estrategia a la acción</p><h2>Una pregunta concreta.<br />Una guía para resolverla.</h2><p>ACOS y TACOS, fichas sin ventas, fondos retenidos o expansión europea. Respuestas, comprobaciones y siguientes pasos.</p></div>
      <a class="growth-button" href="/guias/">Explorar las guías <img src="/icons/lucide/arrow-right.svg" width="20" height="20" alt="" /></a>
    </div></section>
    <ServiceContact topic="la estrategia de mi cuenta Amazon" />
  </div>
</Layout>
<script>
  import { mountBlogFilters } from '../../lib/blog-filters';
  document.querySelectorAll<HTMLElement>('[data-blog-library]').forEach(mountBlogFilters);
</script>
