---
import type { GetStaticPathsResult } from 'astro';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { allBlogPosts, type BlogPost } from '../../data/blog';
import { trainingBlog } from '../../data/training';
import TrainingDiagram from '../../components/TrainingDiagram.astro';
import TrainingContact from '../../components/TrainingContact.astro';
import '../../styles/training.css';

export const prerender = true;
export function getStaticPaths(): GetStaticPathsResult {
  return allBlogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props { post: BlogPost }
const { post } = Astro.props;
---
{post.slug === trainingBlog.slug ? <BlogPostLayout frontmatter={post} compactIndex>
  <TrainingDiagram slot="content-visual" variant="decision" />
  <TrainingContact slot="contact" />
</BlogPostLayout> : <BlogPostLayout frontmatter={post} />}
