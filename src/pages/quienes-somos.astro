---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SubpageBreadcrumbs from '../components/SubpageBreadcrumbs.astro';
import ServiceContact from '../components/ServiceContact.astro';
import { homeShowcase } from '../data/home-showcase';
import '../styles/growth-pages.css';
import '../styles/about-page.css';

export const prerender = true;

const proof = homeShowcase.proof;
const featuredCase = homeShowcase.featuredCase;
const trustpilotReview = featuredCase.reviews.find((review) => review.platform === 'Trustpilot');

const expectations = [
  {
    title: 'Dirección, no una lista de tareas.',
    text: 'Publicidad, catálogo, contenido, precio y stock se priorizan según su efecto en margen, conversión y crecimiento.',
  },
  {
    title: 'Información que sirve para decidir.',
    text: 'Compartimos qué está ocurriendo, por qué importa y qué vamos a hacer después. Un informe debe aportar contexto, no ruido.',
  },
  {
    title: 'Ejecución conectada.',
    text: 'La estrategia no termina en una reunión. La trasladamos a Seller Central, Amazon Ads, listings y operativa.',
  },
  {
    title: 'Una conversación honesta.',
    text: 'Si una hipótesis no funciona, se corrige. Si una promesa no puede sostenerse con datos, no la hacemos.',
  },
];

const serviceLinks = [
  { label: 'Gestión integral de cuenta', href: '/servicios/gestion-de-cuenta/' },
  { label: 'Amazon Ads y PPC', href: '/servicios/gestion-de-ppc/' },
  { label: 'Listings y conversión', href: '/servicios/optimizacion-de-listados/' },
  { label: 'Expansión en Amazon Europa', href: '/servicios/expansion-amazon-europa/' },
];
---

<Layout
  title="Quiénes somos | Agencia Amazon Boost para marcas privadas"
  description="Conoce Amazon Boost, agencia Amazon para marcas privadas en España y Europa. Dirección estratégica, gestión clara y un equipo al que delegar tu cuenta."
  canonicalPath="/quienes-somos/"
  image="/images/sergio-porras-amazon-boost-v2-1440.webp"
  structuredData={{ type: 'organization' }}
>
  <article class="about-page">
    <header class="about-hero">
      <picture class="about-hero-media">
        <!-- Sustituir estas fuentes por la futura fotografía de oficina aprobada. -->
        <source media="(max-width: 760px)" srcset="/images/sergio-porras-amazon-boost-v2-800.webp" />
        <img src="/images/sergio-porras-amazon-boost-v2-1440.webp" alt="Sergio Porras, fundador de la agencia Amazon Boost" width="1440" height="1440" fetchpriority="high" decoding="async" />
      </picture>
      <div class="about-hero-shade" aria-hidden="true"></div>
      <div class="about-shell about-hero-content">
        <SubpageBreadcrumbs items={[{ name: 'Inicio', path: '/' }, { name: 'Quiénes somos', path: '/quienes-somos/' }]} />
        <p class="about-eyebrow">Amazon Boost / Quiénes somos</p>
        <h1>Amazon Boost.<br />Agencia Amazon para marcas privadas.</h1>
        <p class="about-hero-promise">Dirección estratégica, gestión clara y un equipo al que puedes delegar Amazon sin perder el control.</p>
        <p class="about-hero-lead">Trabajamos con marcas que venden o quieren crecer en España y Europa. Conectamos Seller Central, Amazon Ads, contenido, catálogo y stock para que cada decisión responda al mismo objetivo.</p>
        <div class="about-actions">
          <a class="about-button" href="/#auditoria">Solicitar auditoría <Icon name="arrow-right" size={19} /></a>
          <a class="about-text-link" href="/casos-de-exito/">Ver casos reales <Icon name="arrow-up-right" size={17} /></a>
        </div>
      </div>
    </header>

    <nav class="about-local-nav" aria-label="Contenido de quiénes somos">
      <div class="about-shell">
        <a href="#enfoque">Nuestro enfoque</a>
        <a href="#direccion">Dirección</a>
        <a href="#pruebas">Resultados</a>
        <a href="#contacto">Contacto</a>
      </div>
    </nav>

    <section class="about-proof-strip" aria-label="Datos de Amazon Boost">
      <div class="about-shell about-proof-grid">
        {proof.map((item, index) => (
          <div class="about-proof-item">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            {index === 0 && <span class="about-stars" aria-label="Cinco estrellas"><Icon name="star" size={14} filled /><Icon name="star" size={14} filled /><Icon name="star" size={14} filled /><Icon name="star" size={14} filled /><Icon name="star" size={14} filled /></span>}
          </div>
        ))}
      </div>
    </section>

    <section class="about-band about-intro" id="enfoque">
      <div class="about-shell about-intro-grid">
        <div>
          <p class="about-eyebrow">Por qué existe Amazon Boost</p>
          <h2>Delegar la cuenta no debería significar dejar de entenderla.</h2>
        </div>
        <div class="about-intro-copy">
          <p>Amazon concentra demasiadas decisiones conectadas como para gestionarlas por separado. Una campaña cambia el margen. Una rotura de stock frena el posicionamiento. Un listing débil encarece cada clic.</p>
          <p>Amazon Boost nace para reducir esa distancia entre lo que muestran los datos y lo que realmente se ejecuta. Leemos la cuenta completa, priorizamos y asumimos la gestión con una dirección clara.</p>
          <blockquote>Primero entendemos dónde está el margen. Después decidimos cómo crecer.</blockquote>
        </div>
      </div>
    </section>

    <section class="about-band about-expectations" aria-labelledby="expectations-title">
      <div class="about-shell">
        <div class="about-section-head">
          <p class="about-eyebrow">Qué puedes esperar</p>
          <h2 id="expectations-title">Una agencia cerca de la cuenta y de las decisiones.</h2>
        </div>
        <div class="about-expectation-list">
          {expectations.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-band about-direction" id="direccion">
      <div class="about-shell about-direction-grid">
        <div>
          <p class="about-eyebrow">Dirección de Amazon Boost</p>
          <h2>Sergio Porras,<br />fundador de Amazon Boost.</h2>
        </div>
        <div>
          <p class="about-direction-lead">Amazon Boost se construye con una idea sencilla: una marca debe poder delegar su cuenta sin perder visibilidad sobre las decisiones que afectan a su negocio.</p>
          <p>La dirección estratégica permanece cerca del cliente y de Seller Central. Desde ahí coordinamos publicidad, conversión, catálogo, incidencias y operativa para que cada especialista trabaje sobre la misma prioridad.</p>
          <a class="about-linkedin" href="https://www.linkedin.com/in/sergio-deroman-amazon/" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">in</span> Conocer a Sergio en LinkedIn <Icon name="arrow-up-right" size={17} /></a>
        </div>
      </div>
    </section>

    <section class="about-band about-scope" aria-labelledby="scope-title">
      <div class="about-shell">
        <div class="about-section-head about-section-head-wide">
          <p class="about-eyebrow">Nuestro compromiso</p>
          <h2 id="scope-title">Claridad sobre lo que hacemos. También sobre lo que no prometemos.</h2>
        </div>
        <div class="about-scope-grid">
          <div>
            <h3>Nos hacemos cargo de</h3>
            <ul>
              <li><Icon name="check" size={19} /> Dirección y gestión de Seller Central.</li>
              <li><Icon name="check" size={19} /> Amazon Ads con foco en rentabilidad.</li>
              <li><Icon name="check" size={19} /> SEO, listings, imágenes y contenido A+.</li>
              <li><Icon name="check" size={19} /> Catálogo, stock y operativa FBA o FBM.</li>
              <li><Icon name="check" size={19} /> Incidencias y expansión en Amazon Europa.</li>
            </ul>
          </div>
          <div>
            <h3>No vendemos atajos</h3>
            <ul>
              <li><Icon name="x" size={19} /> Un ACOS universal sin conocer tu margen.</li>
              <li><Icon name="x" size={19} /> Posiciones orgánicas garantizadas.</li>
              <li><Icon name="x" size={19} /> Desbloqueos seguros sin estudiar el caso.</li>
              <li><Icon name="x" size={19} /> Informes que no terminan en una decisión.</li>
              <li><Icon name="x" size={19} /> Crecimiento a costa de romper la cuenta.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="about-band about-evidence" id="pruebas">
      <div class="about-shell about-evidence-grid">
        <div class="about-evidence-media">
          <img src={featuredCase.lifestyleImage} alt="Producto del caso de éxito de Amazon Boost en la categoría bebé" width="1200" height="900" loading="lazy" decoding="async" />
        </div>
        <div class="about-evidence-copy">
          <p class="about-eyebrow">El trabajo se demuestra</p>
          <h2>{featuredCase.title}</h2>
          <p>{featuredCase.description}</p>
          <div class="about-case-metrics">
            {featuredCase.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
          </div>
          <a class="about-text-link" href={featuredCase.href}>Abrir el caso completo <Icon name="arrow-right" size={17} /></a>
          {trustpilotReview && (
            <blockquote class="about-review">
              <div class="about-review-stars" aria-label="Cinco de cinco estrellas"><Icon name="star" size={15} filled /><Icon name="star" size={15} filled /><Icon name="star" size={15} filled /><Icon name="star" size={15} filled /><Icon name="star" size={15} filled /></div>
              <p>“{trustpilotReview.fullQuote}”</p>
              <footer>{trustpilotReview.author} · Opinión publicada en Trustpilot</footer>
              <a href={trustpilotReview.url} target="_blank" rel="noopener noreferrer">Ver la reseña externa <Icon name="arrow-up-right" size={15} /></a>
            </blockquote>
          )}
        </div>
      </div>
    </section>

    <section class="about-services" aria-labelledby="services-title">
      <div class="about-shell">
        <p class="about-eyebrow">Cómo podemos ayudarte</p>
        <h2 id="services-title">Un equipo. Toda la cuenta.</h2>
        <div class="about-service-links">
          {serviceLinks.map((service) => <a href={service.href}>{service.label}<Icon name="arrow-up-right" size={18} /></a>)}
        </div>
      </div>
    </section>

    <ServiceContact
      topic="conocer Amazon Boost y revisar mi cuenta"
      preparation={[
        'Qué vendes y en qué marketplaces operas.',
        'Qué parte de la cuenta te preocupa hoy.',
        'Qué objetivo quieres alcanzar en Amazon.',
      ]}
    />
  </article>
</Layout>
