---
import CommercialLayout from '../../layouts/CommercialLayout.astro';
import { servicePages } from '../../data/service-pages';

export const prerender = true;
export function getStaticPaths() {
  return servicePages.filter((page) => page.path.startsWith('/servicios/')).map((page) => ({
    params: { slug: page.path.split('/')[2] }, props: { page },
  }));
}
const { page } = Astro.props;
---
<CommercialLayout page={page} />
