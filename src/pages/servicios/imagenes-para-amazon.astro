---
import Layout from '../../layouts/Layout.astro';
import { imagenesParaAmazonData } from '../../data/services/imagenes-para-amazon.js';
import '../../styles/subpage-redesign.css';

const { metaTitle, metaDescription } = imagenesParaAmazonData;
const collections = [
  {
    id: 'belleza',
    category: 'Belleza',
    title: 'Un producto premium debe parecerlo antes del primer clic.',
    copy: 'Construimos el carrusel para explicar beneficios, uso y diferenciación sin perder la claridad que exige Amazon.',
    source: '/images/1.1.png',
    images: [
      { src: '/images/1.2.png', alt: 'Imagen principal optimizada de un producto de belleza', label: 'Imagen principal' },
      { src: '/images/1.4.png', alt: 'Infografía de beneficios para un producto de belleza', label: 'Beneficios' },
      { src: '/images/1.3.png', alt: 'Imagen lifestyle de un producto de belleza', label: 'Lifestyle' },
      { src: '/images/1.5.png', alt: 'Imagen de ingredientes y modo de uso', label: 'Ingredientes' },
      { src: '/images/1.6.png', alt: 'Imagen de detalles para un producto de belleza', label: 'Detalles' },
    ],
  },
  {
    id: 'bebe',
    category: 'Bebé y regalo',
    title: 'De una foto de producto a una propuesta que se entiende y se recuerda.',
    copy: 'El set visual ordena el contenido del pack, resuelve dudas y sitúa el producto en un contexto de compra real.',
    source: '/images/1.png',
    images: [
      { src: '/images/2.png', alt: 'Imagen principal optimizada de una canastilla de bebé', label: 'Imagen principal' },
      { src: '/images/3.png', alt: 'Imagen lifestyle de una canastilla de bebé', label: 'Lifestyle' },
      { src: '/images/4.png', alt: 'Infografía de contenido de una canastilla', label: 'Contenido' },
      { src: '/images/5.png', alt: 'Imagen de detalles de una canastilla de bebé', label: 'Detalles' },
    ],
  },
];
---

<Layout
  title={metaTitle}
  description={metaDescription}
  pageType="service"
  contentSummary={metaDescription}
  structuredData={{ type: 'service', data: imagenesParaAmazonData }}
>
  <article class="sub-page visual-page">
    <section class="visual-hero">
      <div class="sub-hero-grid" aria-hidden="true"></div>
      <div class="sub-shell visual-hero-layout">
        <div class="visual-hero-copy">
          <p class="sub-kicker"><i></i> Creatividad orientada a conversión</p>
          <h1>Imágenes para Amazon que hacen visible el valor de tu producto.</h1>
          <p>Creamos sets visuales a medida para marcas privadas que necesitan explicar mejor, diferenciarse y convertir más dentro de Amazon Europa.</p>
          <div class="sub-actions">
            <a class="sub-button sub-button-primary" href="/#auditoria">Solicitar propuesta <span aria-hidden="true">↗</span></a>
            <a class="sub-button sub-button-secondary" href="#trabajos">Ver trabajos <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="visual-hero-media" aria-label="Muestra de imágenes creadas para Amazon">
          <img class="visual-hero-back" src="/images/1.3.png" alt="Imagen lifestyle para Amazon" />
          <img class="visual-hero-front" src="/images/2.png" alt="Imagen optimizada de producto para Amazon" />
          <div class="visual-hero-tag"><span>Set visual</span><strong>Diseñado para vender</strong></div>
        </div>
      </div>
      <div class="sub-hero-rail"><span>Estrategia visual</span><i></i><span>Imagen principal</span><i></i><span>Infografías</span><i></i><span>Lifestyle</span></div>
    </section>

    <nav class="sub-jump" aria-label="Navegación de la página">
      <a href="#trabajos">Trabajos</a>
      <a href="#criterio">Criterio visual</a>
      <a href="#proceso">Proceso</a>
      <a class="is-cta" href="/#auditoria">Pedir propuesta</a>
    </nav>

    <section id="criterio" class="sub-band visual-intro">
      <div class="sub-shell visual-intro-layout">
        <div>
          <p class="sub-kicker sub-kicker-dark"><i></i> No decoramos listings</p>
          <h2>Cada imagen tiene un trabajo.</h2>
        </div>
        <p>La primera consigue el clic. Las siguientes sostienen la decisión: explican el beneficio, resuelven objeciones, muestran el uso y hacen reconocible la marca. Diseñamos el conjunto como una secuencia, no como piezas independientes.</p>
      </div>
    </section>

    <section id="trabajos" class="visual-work">
      {collections.map((collection, collectionIndex) => (
        <article class:list={['visual-case', collectionIndex % 2 === 1 && 'is-dark']} data-gallery={collection.id}>
          <div class="sub-shell">
            <header class="visual-case-head">
              <div>
                <p>{collection.category} / Muestra de trabajo</p>
                <h2>{collection.title}</h2>
              </div>
              <p>{collection.copy}</p>
            </header>

            <div class="visual-comparison">
              <div class="visual-source">
                <div class="visual-label"><span>Material de partida</span><strong>Foto base</strong></div>
                <button class="visual-open" type="button" data-full={collection.source} aria-label={`Ampliar foto base de ${collection.category}`}>
                  <img src={collection.source} alt={`Foto base de producto de ${collection.category}`} loading="lazy" />
                </button>
              </div>

              <div class="visual-result">
                <div class="visual-label"><span>Resultado</span><strong>Set optimizado</strong></div>
                <button class="visual-open visual-stage" type="button" data-full={collection.images[0].src} aria-label={`Ampliar resultado de ${collection.category}`}>
                  <img src={collection.images[0].src} alt={collection.images[0].alt} loading="lazy" data-gallery-main />
                </button>
                <div class="visual-thumbs" aria-label={`Seleccionar imagen de ${collection.category}`}>
                  {collection.images.map((image, imageIndex) => (
                    <button
                      class:list={['visual-thumb', imageIndex === 0 && 'is-active']}
                      type="button"
                      data-src={image.src}
                      data-alt={image.alt}
                      aria-label={`Ver ${image.label}`}
                    >
                      <img src={image.src} alt="" loading="lazy" />
                      <span>{image.label}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>
            <p class="visual-note">Muestras visuales provisionales. La selección definitiva de trabajos se actualizará con nuevos casos reales.</p>
          </div>
        </article>
      ))}
    </section>

    <section id="proceso" class="sub-band visual-process-band">
      <div class="sub-shell">
        <div class="sub-heading">
          <p class="sub-kicker sub-kicker-dark"><i></i> Cómo lo construimos</p>
          <h2>Del producto al argumento visual.</h2>
        </div>
        <div class="visual-process">
          <article><span>Entender</span><h3>Producto y cliente</h3><p>Leemos reseñas, competencia, beneficios, objeciones y contexto de compra.</p></article>
          <article><span>Ordenar</span><h3>Guion del carrusel</h3><p>Asignamos una función concreta a cada imagen antes de diseñar.</p></article>
          <article><span>Crear</span><h3>Dirección visual</h3><p>Producimos una estética propia, coherente con la marca y con Amazon.</p></article>
          <article><span>Optimizar</span><h3>Conversión móvil</h3><p>Revisamos lectura, jerarquía y claridad en el espacio más exigente.</p></article>
        </div>
      </div>
    </section>

    <section class="sub-final">
      <div class="sub-shell">
        <div><p>Tu producto ya tiene algo que decir</p><h2>Hagamos que se entienda en segundos.</h2></div>
        <a href="/#auditoria">Pedir propuesta <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </article>

  <dialog class="visual-lightbox" aria-label="Imagen ampliada">
    <button type="button" class="visual-lightbox-close" aria-label="Cerrar">×</button>
    <img alt="Imagen ampliada" />
  </dialog>
</Layout>

<script>
  const prepareVisualPage = () => {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
      const stage = gallery.querySelector<HTMLElement>('.visual-stage');
      gallery.querySelectorAll<HTMLButtonElement>('.visual-thumb').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          if (!main || !thumb.dataset.src) return;
          main.src = thumb.dataset.src;
          main.alt = thumb.dataset.alt || '';
          if (stage) stage.dataset.full = thumb.dataset.src;
          gallery.querySelectorAll('.visual-thumb').forEach((item) => item.classList.remove('is-active'));
          thumb.classList.add('is-active');
        });
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>('.visual-lightbox');
    const dialogImage = dialog?.querySelector<HTMLImageElement>('img');
    document.querySelectorAll<HTMLButtonElement>('.visual-open').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !dialogImage || !button.dataset.full) return;
        dialogImage.src = button.dataset.full;
        dialogImage.alt = button.querySelector('img')?.alt || 'Imagen ampliada';
        dialog.showModal();
      });
    });
    dialog?.querySelector<HTMLButtonElement>('.visual-lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  };

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', prepareVisualPage, { once: true })
    : prepareVisualPage();
</script>

<style>
  .visual-hero{position:relative;overflow:hidden;background:#090909;color:#fff}.visual-hero-layout{position:relative;z-index:1;min-height:760px;display:grid;grid-template-columns:minmax(0,.88fr) minmax(480px,1.12fr);gap:72px;align-items:center;padding:72px 0}.visual-hero-copy h1{max-width:770px;margin:0;font-size:clamp(3.7rem,6vw,6.7rem);line-height:.9;font-weight:850}.visual-hero-copy>p:not(.sub-kicker){max-width:670px;margin:25px 0 0;color:#b4b5af;line-height:1.7}.visual-hero-media{position:relative;height:590px}.visual-hero-media img{position:absolute;display:block;object-fit:cover;box-shadow:0 32px 90px rgba(0,0,0,.55)}.visual-hero-back{top:0;right:0;width:70%;aspect-ratio:1;border:1px solid #2a2a2a}.visual-hero-front{left:0;bottom:0;width:64%;aspect-ratio:1;border:8px solid #0d0d0d}.visual-hero-tag{position:absolute;right:0;bottom:20px;width:210px;padding:17px;background:#ff9900;color:#111}.visual-hero-tag span,.visual-hero-tag strong{display:block}.visual-hero-tag span{font-size:.56rem;font-weight:850;text-transform:uppercase}.visual-hero-tag strong{margin-top:7px;font-size:.85rem}.visual-intro{background:#f4f4ef}.visual-intro-layout{display:grid;grid-template-columns:1fr .75fr;gap:100px;align-items:end}.visual-intro h2{max-width:760px;margin:0;font-size:clamp(3.2rem,5.6vw,6.2rem);line-height:.92}.visual-intro-layout>p{margin:0;color:#53554f;font-size:1.04rem;line-height:1.75}.visual-case{padding:110px 0;background:#fff;color:#111}.visual-case.is-dark{background:#0b0b0b;color:#fff}.visual-case-head{display:grid;grid-template-columns:1fr .6fr;gap:80px;align-items:end;margin-bottom:54px}.visual-case-head p{margin:0;color:#6a6c66;line-height:1.65}.visual-case-head>div>p{margin-bottom:18px;color:#a46100;font-size:.62rem;font-weight:850;text-transform:uppercase}.is-dark .visual-case-head p{color:#9b9d97}.is-dark .visual-case-head>div>p{color:#ff9900}.visual-case-head h2{max-width:850px;margin:0;font-size:clamp(2.8rem,4.8vw,5.3rem);line-height:.94}.visual-comparison{display:grid;grid-template-columns:.62fr 1.38fr;gap:22px}.visual-source,.visual-result{min-width:0}.visual-label{display:flex;justify-content:space-between;gap:20px;margin-bottom:12px;padding:0 2px}.visual-label span{color:#7b7d76;font-size:.58rem;font-weight:850;text-transform:uppercase}.visual-label strong{font-size:.64rem}.visual-open{display:block;width:100%;padding:0;border:0;background:#ecece7;cursor:zoom-in}.visual-open img{display:block;width:100%;height:100%;object-fit:contain}.visual-source .visual-open{aspect-ratio:1}.visual-stage{aspect-ratio:16/10}.is-dark .visual-open{background:#141414}.visual-thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:8px}.visual-thumb{min-width:0;padding:0 0 9px;border:0;border-bottom:2px solid transparent;background:transparent;color:inherit;cursor:pointer;text-align:left}.visual-thumb img{display:block;width:100%;aspect-ratio:1;object-fit:cover;opacity:.55;transition:opacity .2s ease}.visual-thumb span{display:block;margin-top:8px;overflow:hidden;font-size:.52rem;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.visual-thumb:hover img,.visual-thumb.is-active img{opacity:1}.visual-thumb.is-active{border-color:#ff9900}.visual-note{margin:20px 0 0;color:#858780;font-size:.64rem}.visual-process-band{background:#f4f4ef}.visual-process{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #d2d2cb;border-left:1px solid #d2d2cb}.visual-process article{min-height:300px;padding:25px;border-right:1px solid #d2d2cb;border-bottom:1px solid #d2d2cb}.visual-process span{color:#a46100;font-size:.6rem;font-weight:850;text-transform:uppercase}.visual-process h3{margin:95px 0 15px;font-size:1.45rem}.visual-process p{margin:0;color:#5b5d57;font-size:.8rem;line-height:1.6}.visual-lightbox{width:min(1100px,calc(100% - 32px));height:min(90vh,900px);padding:0;border:1px solid #333;background:#0a0a0a}.visual-lightbox::backdrop{background:rgba(0,0,0,.88)}.visual-lightbox img{width:100%;height:100%;object-fit:contain}.visual-lightbox-close{position:absolute;z-index:2;top:12px;right:12px;width:42px;height:42px;border:1px solid #555;background:#111;color:#fff;font-size:1.7rem;cursor:pointer}
  @media(max-width:1050px){.visual-hero-layout{grid-template-columns:1fr;padding-top:90px}.visual-hero-media{height:620px}.visual-hero-back{width:65%}.visual-hero-front{width:60%}.visual-intro-layout,.visual-case-head{grid-template-columns:1fr;gap:35px}.visual-comparison{grid-template-columns:1fr}.visual-source{max-width:620px}.visual-process{grid-template-columns:1fr 1fr}.visual-process article{min-height:230px}.visual-process h3{margin-top:55px}}
  @media(max-width:700px){.visual-hero-layout{min-height:auto;gap:45px;padding:72px 0 54px}.visual-hero-copy h1{font-size:clamp(2.9rem,12vw,4.1rem)}.visual-hero-media{height:380px}.visual-hero-back{width:72%}.visual-hero-front{width:69%;border-width:5px}.visual-hero-tag{bottom:8px;width:165px;padding:13px}.visual-intro h2,.visual-case-head h2{font-size:clamp(2.55rem,11vw,3.75rem)}.visual-case{padding:75px 0}.visual-case-head{margin-bottom:35px}.visual-thumbs{grid-template-columns:repeat(3,1fr);gap:9px}.visual-thumb span{white-space:normal}.visual-process{grid-template-columns:1fr}.visual-process article{min-height:205px;padding:22px}.visual-process h3{margin-top:46px}}
</style>
