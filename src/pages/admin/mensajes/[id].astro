---
import Layout from '../../../layouts/Layout.astro';
import MessageDetail from '../../../components/MessageDetail.jsx';

// Message IDs are created after build, so the client-side detail shell must
// be served for any ID instead of relying on a static path list.
export const prerender = false;

const { id } = Astro.params;
---

<Layout title="Detalle de Mensaje - Admin">
  <MessageDetail messageId={id} client:only="react" />
</Layout>
