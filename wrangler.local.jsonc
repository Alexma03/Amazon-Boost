{
  // Local development only. Production requires its own real D1 binding and secrets.
  "name": "amazon-boost-local",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "BOOST_GUARD",
    "database_name": "amazon-boost-guard-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations/boost-guard"
  }],
  "kv_namespaces": [{ "binding": "SESSION", "id": "local-session" }]
}
